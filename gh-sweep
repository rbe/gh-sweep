    local loc=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}
    case $loc in
      *[Uu][Tt][Ff]*) unicode=1 ;;
    esac
  fi
  if (( unicode )); then
    SEP=$' · '
    RULE_CHAR=$'─'
    ELLIPSIS=$'…'
  else
    SEP=' | '
    RULE_CHAR='-'
    ELLIPSIS='~'
  fi
  if (( use_color )); then
    C_RESET=$'\033[0m'
