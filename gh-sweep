#!/usr/bin/env bash
# gh-sweep — delete GitHub Actions artifacts and caches.
#
# Start on a project list. Check a repository and press d to delete every
# artifact and cache in it, or press enter and check individual rows.
# Artifact rows are grouped by name, cache rows by key. Nothing is deleted
# until you confirm. Large files are deleted first, because a few artifacts
# usually hold almost all of the bytes, and expired artifacts still count
# against the Actions storage quota.
#
#   gh-sweep
#   gh-sweep owner/repo other/repo
#   gh-sweep --org my-org
#   gh-sweep --mine
#   gh sweep owner/repo          # if this file is on PATH as gh-sweep
#
# Needs bash 3.2+ (the bash that ships with macOS) and the GitHub CLI.

VERSION=1.0.0
STRICT_COUNT=20
STRICT_BYTES=$((1024 * 1024 * 1024))
CACHE_CAP=10000

usage() {
  cat <<'EOF'
Usage: gh-sweep [options] [owner/repo ...]

Delete GitHub Actions artifacts and caches from one or more repositories.
The first screen is the project list:

  space    mark a project, then d deletes ALL of its artifacts and caches
  enter    open that project and check individual artifacts or caches

With no arguments, the current checkout is listed. --org and --mine fill
the list from GitHub so you can pick repositories.

Options:
  -R, --repo OWNER/REPO   Repository, repeatable (same as a positional arg)
  --org ORG               List repositories in this organization
  --user USER             List repositories owned by this user
  --mine                  List repositories for the logged-in user
  --artifacts-only        Don't list or delete caches
  --caches-only           Don't list or delete artifacts
  --filter TEXT           Start the item view with this filter
  --dry-run               Walk through confirmations without deleting
  --ascii                 ASCII rules and separators
  --no-color              Disable color
  -V, --version           Print version
  -h, --help              Show this help

Project keys:
  space a n    mark, mark all shown, clear shown
  enter        pick individual artifacts and caches
  d            delete everything in the marked projects
  s            scan sizes without deleting
  +            add owner/repo
  /            filter the project list
  q            quit

Inside a project:
  space        toggle the row. A group toggles every row inside it.
  enter        toggle an item, or open and close a group
  j k          move. Arrows do the same. J/K or PgUp/PgDn page.
  h l          collapse or expand. e/c fold all. g/G top and bottom.
  a n          select or clear what the filter shows. A and C limit the kind.
  N            clear every selection, including rows a filter hides
  x            select expired artifacts (they still use quota)
  o            select artifacts older than N days
  t            keep the newest N of each artifact name, select the rest
  d            delete the checked rows. y confirms.
  b            back to the project list
  / r ? q      filter, refresh, help, quit

Deletes run largest-first and call:
  gh api -X DELETE repos/OWNER/REPO/actions/artifacts/ID
  gh cache delete ID -R OWNER/REPO

GitHub recalculates artifact usage every 6–12 hours, so a deploy can still
report a full quota after a successful cleanup.
EOF
}

die() {
  printf 'gh-sweep: %s\n' "$1" >&2
  exit 2
}

parse_args() {
  repo=""
  cli_repos=()
  org_name=""
  user_name=""
  list_mine=0
  dry_run=0
  only=""
  ascii_flag=0
  no_color_flag=0
  initial_filter=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help)
        usage
        exit 0
        ;;
      -V|--version)
        printf 'gh-sweep %s\n' "$VERSION"
        exit 0
        ;;
      -R|--repo)
        [[ $# -ge 2 ]] || die "missing repository after $1"
        cli_repos+=("$2")
        shift 2
        ;;
      --repo=*)
        cli_repos+=("${1#--repo=}")
        shift
        ;;
      --org)
        [[ $# -ge 2 ]] || die "missing organization after --org"
        org_name=$2
        shift 2
        ;;
      --org=*)
        org_name=${1#--org=}
        shift
        ;;
      --user)
        [[ $# -ge 2 ]] || die "missing user after --user"
        user_name=$2
        shift 2
        ;;
      --user=*)
        user_name=${1#--user=}
        shift
        ;;
      --mine)
        list_mine=1
        shift
        ;;
      --artifacts-only)
        [[ $only != cache ]] || die "use either --artifacts-only or --caches-only"
        only=artifact
        shift
        ;;
      --caches-only)
        [[ $only != artifact ]] || die "use either --artifacts-only or --caches-only"
        only=cache
        shift
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      --ascii)
        ascii_flag=1
        shift
        ;;
      --no-color)
        no_color_flag=1
        shift
        ;;
      --filter)
        [[ $# -ge 2 ]] || die "missing text after --filter"
        initial_filter=$2
        shift 2
        ;;
      --filter=*)
        initial_filter=${1#--filter=}
        shift
        ;;
      --)
        shift
        while [[ $# -gt 0 ]]; do
          cli_repos+=("$1")
          shift
        done
        ;;
      -*)
        die "unknown option: $1 (try --help)"
        ;;
      *)
        cli_repos+=("$1")
        shift
        ;;
    esac
  done
  if ((${#cli_repos[@]} > 0)) && [[ -n $org_name || -n $user_name || $list_mine == 1 ]]; then
    die "pass repositories or --org/--user/--mine, not both"
  fi
  if [[ -n $org_name && (-n $user_name || $list_mine == 1) ]]; then
    die "use only one of --org, --user, or --mine"
  fi
  if [[ -n $user_name && $list_mine == 1 ]]; then
    die "use only one of --user or --mine"
  fi
}

# Sets host, owner, name, api_hostname, repo_nwo_full. Returns 1 if invalid.
parse_repo() {
  local raw=$1 rest h
  raw=${raw%.git}
  host=""
  owner=""
  name=""
  api_hostname=""
  repo_nwo_full=""
  case $raw in
    */*/*/*) return 1 ;;
    */*/*)
      host=${raw%%/*}
      rest=${raw#*/}
      owner=${rest%%/*}
      name=${rest#*/}
      ;;
    */*)
      owner=${raw%%/*}
      name=${raw#*/}
      ;;
    *) return 1 ;;
  esac
  name=${name%.git}
  [[ -n $owner && -n $name ]] || return 1
  [[ $owner != "." && $owner != ".." && $name != "." && $name != ".." ]] || return 1
  [[ $owner =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || return 1
  [[ $name =~ ^[A-Za-z0-9_.][A-Za-z0-9_.-]*$ ]] || return 1
  if [[ -n $host ]]; then
    [[ $host == *.* ]] || return 1
    [[ $host =~ ^[A-Za-z0-9.-]+$ ]] || return 1
    [[ $host != *..* ]] || return 1
    if [[ $host == github.com || $host == www.github.com ]]; then
      host=""
    fi
  fi
  if [[ -n $host ]]; then
    api_hostname=$host
    repo_nwo_full="${host}/${owner}/${name}"
  else
    api_hostname=""
    repo_nwo_full="${owner}/${name}"
  fi
  return 0
}

