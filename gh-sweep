detect_date() {
  if date -j -f "%Y-%m-%d" "2020-01-02" "+%Y-%m-%d" >/dev/null 2>&1; then
    DATE_KIND=bsd
  else
    DATE_KIND=gnu
  fi
}

strip_controls() {
  printf '%s' "$1" | LC_ALL=C tr -d '[:cntrl:]'
}

plural_word() {
  local n=$1 one=$2 many=$3
  if [[ $n == 1 ]]; then
    printf '%s' "$one"
  else
    printf '%s' "$many"
  fi
}

_fit() {
  local s=$1 w=$2 n
  n=${#s}
  if (( w <= 0 )); then
    FIT=""
    return
  fi
  if (( n <= w )); then
    FIT=$s
    return
  fi
  if (( w == 1 )); then
    FIT=$ELLIPSIS
    return
  fi
  FIT="${s:0:w-1}${ELLIPSIS}"
}

fit_print() {
  _fit "$1" "$2"
  printf '%s' "$FIT"
}

human_size() {
  local b=${1:-0}
  if [[ ! $b =~ ^[0-9]+$ ]]; then
    b=0
  fi
  awk -v b="$b" 'BEGIN {
    split("B KB MB GB TB PB", u, " ")
    i = 1
    n = b + 0
    while (n >= 1024 && i < 6) {
      n /= 1024
      i++
    }
    if (i == 1) printf "%d B", n
    else if (n >= 100) printf "%.0f %s", n, u[i]
    else printf "%.1f %s", n, u[i]
  }'
}

fmt_day() {
  local epoch=$1
  if [[ $DATE_KIND == bsd ]]; then
    date -r "$epoch" "+%Y-%m-%d" 2>/dev/null || printf '%s' '-'
  else
    date -d "@$epoch" "+%Y-%m-%d" 2>/dev/null || printf '%s' '-'
  fi
}

human_time() {
  local epoch=${1:-0} now d
  if [[ ! $epoch =~ ^[0-9]+$ || $epoch == 0 ]]; then
    printf '%s' '-'
    return
  fi
  if [[ -n ${NOW_EPOCH:-} ]]; then
    now=$NOW_EPOCH
  else
    now=$(date +%s)
  fi
  d=$((now - epoch))
  if (( d < 0 )); then
    d=0
  fi
  if (( d < 60 )); then
    printf 'just now'
  elif (( d < 3600 )); then
    printf '%dm ago' $((d / 60))
  elif (( d < 86400 )); then
    printf '%dh ago' $((d / 3600))
  elif (( d < 14 * 86400 )); then
    printf '%dd ago' $((d / 86400))
  else
    fmt_day "$epoch"
  fi
}

# ISO-8601 to epoch seconds. Fractional seconds and numeric offsets are
# accepted. Z means UTC. Empty or unparseable input prints 0.
iso_to_epoch() {
  local s=${1:-} head tail base sign hh mm offset epoch
  if [[ -z $s || $s == null ]]; then
    printf '0'
    return
  fi
  if [[ $s == *.* ]]; then
    head=${s%%.*}
    tail=${s#*.}
    tail=$(printf '%s' "$tail" | sed -E 's/^[0-9]+//')
    s="${head}${tail}"
  fi
  base=$s
  offset=0
  if [[ $s == *Z ]]; then
    base=${s%Z}
  elif [[ $s =~ ^(.+)([+-])([0-9]{2}):([0-9]{2})$ ]]; then
    base=${BASH_REMATCH[1]}
    sign=${BASH_REMATCH[2]}
    hh=${BASH_REMATCH[3]}
    mm=${BASH_REMATCH[4]}
    offset=$((10#$hh * 3600 + 10#$mm * 60))
    if [[ $sign == "+" ]]; then
      offset=$((-offset))
    fi
  fi
  if [[ $DATE_KIND == bsd ]]; then
    epoch=$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$base" "+%s" 2>/dev/null || true)
  else
    epoch=$(TZ=UTC date -u -d "$base" "+%s" 2>/dev/null || true)
  fi
  if [[ ! $epoch =~ ^[0-9]+$ ]]; then
    printf '0'
    return
  fi
  printf '%s' $((epoch + offset))
}

shorten_ref() {
  local r=${1:-} n
  case $r in
    "") printf '%s' '-' ;;
    refs/heads/*) printf '%s' "${r#refs/heads/}" ;;
    refs/tags/*) printf 'tag:%s' "${r#refs/tags/}" ;;
    refs/pull/*/merge)
      n=${r#refs/pull/}
      n=${n%/merge}
      printf 'pr/%s' "$n"
      ;;
    refs/pull/*/head)
      n=${r#refs/pull/}
      n=${n%/head}
      printf 'pr/%s' "$n"
      ;;
    *) printf '%s' "$r" ;;
  esac
}

add_item() {
  local kind=$1 id=$2 name=$3 size=$4 epoch=$5 meta=$6 expired=$7 run=$8 extra=${9:-}
  local i blob skip_key
  if [[ $kind == artifact ]]; then
    skip_key="a:${id}"
  else
    skip_key="c:${id}"
  fi
  case ${SKIP_SET:-|} in
    *"|${skip_key}|"*) return 0 ;;
  esac
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_kind[$i]} == "$kind" && ${item_id[$i]} == "$id" ]]; then
      return 0
    fi
  done
  if [[ -z $name ]]; then
    name="(unnamed)"
  fi
  if ((${#name} > 300)); then
    name=${name:0:300}
  fi
  blob="$name $meta $id $kind"
  if [[ $expired == 1 ]]; then
    blob+=" expired"
  fi
  if [[ -n $run && $run != 0 ]]; then
    blob+=" $run"
  fi
  if [[ -n $extra ]]; then
    blob+=" $extra"
  fi
  blob=$(printf '%s' "$blob" | tr '[:upper:]' '[:lower:]')
  item_kind+=("$kind")
  item_id+=("$id")
  item_name+=("$name")
  item_size+=("$size")
  item_epoch+=("$epoch")
  item_meta+=("$meta")
  item_expired+=("$expired")
  item_on+=("0")
  item_dead+=("0")
  item_search+=("$blob")
  item_group+=("-1")
  item_run+=("$run")
  n_items=$((n_items + 1))
}

parse_artifact_stream() {
  local line id name size created expired branch run epoch
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line ]] && continue
    if [[ $line == T\ * ]]; then
      art_total_count=${line#T }
      if [[ ! $art_total_count =~ ^[0-9]+$ ]]; then
        art_total_count=0
      fi
      continue
    fi
    IFS=$'\037' read -r id name size created expired branch run <<< "$line"
    id=$(strip_controls "$id")
    name=$(strip_controls "$name")
    size=$(strip_controls "$size")
    created=$(strip_controls "$created")
    expired=$(strip_controls "$expired")
    branch=$(strip_controls "$branch")
    run=$(strip_controls "$run")
    [[ $id =~ ^[0-9]+$ ]] || continue
    [[ $size =~ ^[0-9]+$ ]] || size=0
    if [[ $expired != 1 ]]; then
      expired=0
    fi
    branch=$(shorten_ref "$branch")
    epoch=$(iso_to_epoch "$created")
    add_item artifact "$id" "$name" "$size" "$epoch" "$branch" "$expired" "$run"
  done
}

parse_cache_stream() {
  local line id key size created ref accessed epoch meta
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line ]] && continue
    IFS=$'\037' read -r id key size created ref accessed <<< "$line"
    id=$(strip_controls "$id")
    key=$(strip_controls "$key")
    size=$(strip_controls "$size")
    created=$(strip_controls "$created")
    ref=$(strip_controls "$ref")
    accessed=$(strip_controls "$accessed")
    [[ $id =~ ^[0-9]+$ ]] || continue
    [[ $size =~ ^[0-9]+$ ]] || size=0
    epoch=$(iso_to_epoch "$accessed")
    if [[ $epoch == 0 ]]; then
      epoch=$(iso_to_epoch "$created")
    fi
    meta=$(shorten_ref "$ref")
    add_item cache "$id" "$key" "$size" "$epoch" "$meta" 0 "" "$ref"
  done
}

