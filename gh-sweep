regroup() {
  local kind=$1 expand_new=$2
  local i any=0 line name epoch idx prev have_prev g
  : > "$tmpdir/sortin"
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_kind[$i]} != "$kind" ]]; then
      continue
    fi
    any=1
    printf '%s\037%s\037%s\n' "${item_name[$i]}" "${item_epoch[$i]}" "$i" >> "$tmpdir/sortin"
  done
  if ((any == 0)); then
    return
  fi
  LC_ALL=C sort -t $'\037' -k1,1 -k2,2nr -k3,3n "$tmpdir/sortin" > "$tmpdir/sortout"
  have_prev=0
  prev=""
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line ]] && continue
    IFS=$'\037' read -r name epoch idx <<< "$line"
    [[ -n ${idx:-} ]] || continue
    if ((have_prev == 0)) || [[ $name != "$prev" ]]; then
      group_kind+=("$kind")
      group_name+=("$name")
      group_start+=("${#new_kind[@]}")
      group_len+=(0)
      group_open+=("$expand_new")
      group_bytes+=(0)
      prev=$name
      have_prev=1
    fi
    g=$((${#group_kind[@]} - 1))
    new_kind+=("${item_kind[$idx]}")
    new_id+=("${item_id[$idx]}")
    new_name+=("${item_name[$idx]}")
    new_size+=("${item_size[$idx]}")
    new_epoch+=("${item_epoch[$idx]}")
    new_meta+=("${item_meta[$idx]}")
    new_expired+=("${item_expired[$idx]}")
    new_on+=("${item_on[$idx]}")
    new_dead+=("${item_dead[$idx]}")
    new_search+=("${item_search[$idx]}")
    new_group+=("$g")
    new_run+=("${item_run[$idx]}")
    group_len[$g]=$((group_len[$g] + 1))
    if [[ ${item_dead[$idx]} != 1 ]]; then
      group_bytes[$g]=$((group_bytes[$g] + ${item_size[$idx]}))
    fi
  done < "$tmpdir/sortout"
}

order_groups() {
  local kind=$1
  local g any=0 line b nm id
  local out_g
  out_g=()
  : > "$tmpdir/gsort"
  for ((g = 0; g < ${#group_kind[@]}; g++)); do
    if [[ ${group_kind[$g]} != "$kind" ]]; then
      continue
    fi
    any=1
    printf '%s\037%s\037%s\n' "${group_bytes[$g]}" "${group_name[$g]}" "$g" >> "$tmpdir/gsort"
  done
  if ((any == 0)); then
    if [[ $kind == artifact ]]; then
      art_groups=()
    else
      cache_groups=()
    fi
    return
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line ]] && continue
    IFS=$'\037' read -r b nm id <<< "$line"
    [[ -n ${id:-} ]] || continue
    out_g+=("$id")
  done < <(LC_ALL=C sort -t $'\037' -k1,1nr -k2,2 "$tmpdir/gsort")
  if ((${#out_g[@]} == 0)); then
    return
  fi
  if [[ $kind == artifact ]]; then
    art_groups=("${out_g[@]}")
  else
    cache_groups=("${out_g[@]}")
  fi
}

rebuild_groups() {
  local expand_new=0
  if ((first_build && auto_expand && n_items <= 10 && n_items > 0)); then
    expand_new=1
  fi
  first_build=0
  clear_new_items
  group_kind=()
  group_name=()
  group_start=()
  group_len=()
  group_open=()
  group_bytes=()
  regroup artifact "$expand_new"
  regroup cache "$expand_new"
  commit_new_items
  order_groups artifact
  order_groups cache
}

finalize_notes() {
  local n=0 c=0 i note=""
  load_note=""
  if [[ -n $art_error ]]; then
    load_note=$art_error
    return
  fi
  if [[ -n $cache_error ]]; then
    load_note=$cache_error
    return
  fi
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_kind[$i]} == artifact ]]; then
      n=$((n + 1))
    else
      c=$((c + 1))
    fi
  done
  if ((want_art && art_total_count > n)); then
    note="GitHub reports ${art_total_count} artifacts; the API returned ${n}."
  fi
  if ((want_cache && c >= CACHE_CAP)); then
    if [[ -n $note ]]; then
      note+=" Cache list stopped at ${CACHE_CAP}."
    else
      note="Cache list stopped at ${CACHE_CAP} entries."
    fi
  fi
  load_note=$note
}

apply_streams() {
  local ae=${art_error:-} ce=${cache_error:-}
  local raw_a=${ART_RAW:-} raw_c=${CACHE_RAW:-}
  reset_model
  art_error=$ae
  cache_error=$ce
  ART_RAW=$raw_a
  CACHE_RAW=$raw_c
  if ((want_art)); then
    parse_artifact_stream <<< "$ART_RAW"
  fi
  if ((want_cache)); then
    parse_cache_stream <<< "$CACHE_RAW"
  fi
  rebuild_groups
  finalize_notes
}

item_match() {
  local i=$1
  if [[ -z $filter_l ]]; then
    return 0
  fi
  case ${item_search[$i]} in
    *"$filter_l"*) return 0 ;;
  esac
  return 1
}

range_stats() {
  local start=$1 len=$2 i end
  end=$((start + len))
  STAT_LIVE=0
  STAT_ON=0
  STAT_BYTES=0
  STAT_STATE=none
  for ((i = start; i < end; i++)); do
    if [[ ${item_dead[$i]} == 1 ]]; then
      continue
    fi
    if ! item_match "$i"; then
      continue
    fi
    STAT_LIVE=$((STAT_LIVE + 1))
    STAT_BYTES=$((STAT_BYTES + ${item_size[$i]}))
    if [[ ${item_on[$i]} == 1 ]]; then
      STAT_ON=$((STAT_ON + 1))
    fi
  done
  if ((STAT_LIVE > 0 && STAT_ON == STAT_LIVE)); then
    STAT_STATE=all
  elif ((STAT_ON > 0)); then
    STAT_STATE=some
  else
    STAT_STATE=none
  fi
}

kind_stats() {
  local kind=$1 i
  STAT_LIVE=0
  STAT_ON=0
  STAT_BYTES=0
  STAT_STATE=none
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_kind[$i]} != "$kind" ]]; then
      continue
    fi
    if [[ ${item_dead[$i]} == 1 ]]; then
      continue
    fi
    if ! item_match "$i"; then
      continue
    fi
    STAT_LIVE=$((STAT_LIVE + 1))
    STAT_BYTES=$((STAT_BYTES + ${item_size[$i]}))
    if [[ ${item_on[$i]} == 1 ]]; then
      STAT_ON=$((STAT_ON + 1))
    fi
  done
  if ((STAT_LIVE > 0 && STAT_ON == STAT_LIVE)); then
    STAT_STATE=all
  elif ((STAT_ON > 0)); then
    STAT_STATE=some
  else
    STAT_STATE=none
  fi
}

group_has_live() {
  range_stats "${group_start[$1]}" "${group_len[$1]}"
  if ((STAT_LIVE > 0)); then
    return 0
  fi
  return 1
}

section_visible() {
  local kind=$1 g
  if [[ $kind == artifact ]]; then
    if ((${#art_groups[@]} == 0)); then
      return 1
    fi
    for g in "${art_groups[@]}"; do
      if group_has_live "$g"; then
        return 0
      fi
    done
    return 1
  fi
  if ((${#cache_groups[@]} == 0)); then
    return 1
  fi
  for g in "${cache_groups[@]}"; do
    if group_has_live "$g"; then
      return 0
    fi
  done
  return 1
}

append_groups() {
  local kind=$1 g i start end
  if [[ $kind == artifact ]]; then
    if ((${#art_groups[@]} == 0)); then
      return
    fi
    for g in "${art_groups[@]}"; do
      if ! group_has_live "$g"; then
        continue
      fi
      view_type+=("group")
      view_ref+=("$g")
      if [[ ${group_open[$g]} == 1 || -n $filter_l ]]; then
        start=${group_start[$g]}
        end=$((start + group_len[$g]))
        for ((i = start; i < end; i++)); do
          if [[ ${item_dead[$i]} == 1 ]]; then
            continue
          fi
          if ! item_match "$i"; then
            continue
          fi
          view_type+=("item")
          view_ref+=("$i")
        done
      fi
    done
    return
  fi
  if ((${#cache_groups[@]} == 0)); then
    return
  fi
  for g in "${cache_groups[@]}"; do
    if ! group_has_live "$g"; then
      continue
    fi
    view_type+=("group")
    view_ref+=("$g")
    if [[ ${group_open[$g]} == 1 || -n $filter_l ]]; then
      start=${group_start[$g]}
      end=$((start + group_len[$g]))
      for ((i = start; i < end; i++)); do
        if [[ ${item_dead[$i]} == 1 ]]; then
          continue
        fi
        if ! item_match "$i"; then
          continue
        fi
        view_type+=("item")
        view_ref+=("$i")
      done
    fi
  done
}

build_view() {
  view_type=()
  view_ref=()
  if ((want_art)) && section_visible artifact; then
    view_type+=("section")
    view_ref+=("artifact")
    append_groups artifact
  fi
  if ((want_cache)) && section_visible cache; then
    view_type+=("section")
    view_ref+=("cache")
    append_groups cache
  fi
}

place_cursor() {
  local t=${1:-} r=${2:-} i n
  n=${#view_type[@]}
  cursor=0
  if [[ -n $t && n -gt 0 ]]; then
    for ((i = 0; i < n; i++)); do
      if [[ ${view_type[$i]} == "$t" && ${view_ref[$i]} == "$r" ]]; then
        cursor=$i
        return
      fi
    done
  fi
  if ((n > 0)); then
    for ((i = 0; i < n; i++)); do
      if [[ ${view_type[$i]} == group || ${view_type[$i]} == item ]]; then
        cursor=$i
        return
      fi
    done
  fi
  cursor=0
}

update_view_keep_cursor() {
  local t="" r=""
  if ((${#view_type[@]} > 0 && cursor >= 0 && cursor < ${#view_type[@]})); then
    t=${view_type[$cursor]}
    r=${view_ref[$cursor]}
  fi
  build_view
  place_cursor "$t" "$r"
  ensure_scroll
}

toggle_group() {
  local g=$1 v=1 i start end
  range_stats "${group_start[$g]}" "${group_len[$g]}"
  if [[ $STAT_STATE == all ]]; then
    v=0
  fi
  start=${group_start[$g]}
  end=$((start + group_len[$g]))
  for ((i = start; i < end; i++)); do
    if [[ ${item_dead[$i]} == 1 ]]; then
      continue
    fi
    if item_match "$i"; then
      item_on[$i]=$v
    fi
  done
}

toggle_kind() {
  local kind=$1 v=1 i
  kind_stats "$kind"
  if [[ $STAT_STATE == all ]]; then
    v=0
  fi
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_kind[$i]} != "$kind" ]]; then
      continue
    fi
    if [[ ${item_dead[$i]} == 1 ]]; then
      continue
    fi
    if item_match "$i"; then
      item_on[$i]=$v
    fi
  done
}

toggle_item() {
  local i=$1
  if [[ ${item_on[$i]} == 1 ]]; then
    item_on[$i]=0
  else
    item_on[$i]=1
  fi
}

toggle_current() {
  local n=${#view_type[@]} t r
  if ((n == 0)); then
    return
  fi
  t=${view_type[$cursor]}
  r=${view_ref[$cursor]}
  case $t in
    section) toggle_kind "$r" ;;
    group) toggle_group "$r" ;;
    item) toggle_item "$r" ;;
  esac
}

select_visible() {
  local value=$1 kind=$2 i
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_dead[$i]} == 1 ]]; then
      continue
    fi
    if [[ -n $kind && ${item_kind[$i]} != "$kind" ]]; then
      continue
    fi
    if item_match "$i"; then
      item_on[$i]=$value
    fi
  done
}

clear_all_selection() {
  local i
  for ((i = 0; i < n_items; i++)); do
    item_on[$i]=0
  done
}

select_expired() {
  local i c=0
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_kind[$i]} != artifact ]]; then
      continue
    fi
    if [[ ${item_dead[$i]} == 1 || ${item_expired[$i]} != 1 ]]; then
      continue
    fi
    if item_match "$i"; then
      item_on[$i]=1
      c=$((c + 1))
    fi
  done
  status_msg="Selected ${c} expired $(plural_word "$c" artifact artifacts)"
}

select_older() {
  local days=$1 now cutoff i c=0
  if [[ -n ${NOW_EPOCH:-} ]]; then
    now=$NOW_EPOCH
  else
    now=$(date +%s)
  fi
  cutoff=$((now - days * 86400))
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_kind[$i]} != artifact || ${item_dead[$i]} == 1 ]]; then
      continue
    fi
    if [[ ! ${item_epoch[$i]} =~ ^[0-9]+$ || ${item_epoch[$i]} == 0 ]]; then
      continue
    fi
    if ((${item_epoch[$i]} > cutoff)); then
      continue
    fi
    if item_match "$i"; then
      item_on[$i]=1
      c=$((c + 1))
    fi
  done
  status_msg="Selected ${c} $(plural_word "$c" artifact artifacts) older than ${days} days"
}

count_selected() {
  local i
  SEL_COUNT=0
  SEL_BYTES=0
  SEL_ART=0
  SEL_CACHE=0
  SEL_HIDDEN=0
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_dead[$i]} == 1 || ${item_on[$i]} != 1 ]]; then
      continue
    fi
    SEL_COUNT=$((SEL_COUNT + 1))
    SEL_BYTES=$((SEL_BYTES + ${item_size[$i]}))
    if [[ ${item_kind[$i]} == artifact ]]; then
      SEL_ART=$((SEL_ART + 1))
    else
      SEL_CACHE=$((SEL_CACHE + 1))
    fi
    if ! item_match "$i"; then
      SEL_HIDDEN=$((SEL_HIDDEN + 1))
    fi
  done
}

count_shown() {
  local i n=0
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_dead[$i]} == 1 ]]; then
      continue
    fi
    if item_match "$i"; then
      n=$((n + 1))
    fi
  done
  printf '%s' "$n"
}

counts_line() {
  local ac=0 cc=0 bytes=0 i parts=""
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_dead[$i]} == 1 ]]; then
      continue
    fi
    bytes=$((bytes + ${item_size[$i]}))
    if [[ ${item_kind[$i]} == artifact ]]; then
      ac=$((ac + 1))
    else
      cc=$((cc + 1))
    fi
  done
  if ((want_art)); then
    parts="${ac} $(plural_word "$ac" artifact artifacts)"
  fi
  if ((want_cache)); then
    if [[ -n $parts ]]; then
      parts+="$SEP"
    fi
    parts+="${cc} $(plural_word "$cc" cache caches)"
  fi
  if [[ -n $parts ]]; then
    parts+="$SEP"
  fi
  parts+="$(human_size "$bytes")"
  printf '%s' "$parts"
}

summary_text() {
  count_selected
  if [[ -n $status_msg ]]; then
    printf '%s' "$status_msg"
    return
  fi
  if ((SEL_COUNT == 0)); then
    printf 'nothing selected'
    return
  fi
  printf '%d selected%s%s%s%d %s%s%d %s' \
    "$SEL_COUNT" "$SEP" "$(human_size "$SEL_BYTES")" "$SEP" \
    "$SEL_ART" "$(plural_word "$SEL_ART" artifact artifacts)" "$SEP" \
    "$SEL_CACHE" "$(plural_word "$SEL_CACHE" cache caches)"
  if ((SEL_HIDDEN > 0)); then
    printf '%s%d hidden by filter' "$SEP" "$SEL_HIDDEN"
  fi
}

# --- rendering -----------------------------------------------------------

term_size() {
  local size
  if [[ -n ${GH_SWEEP_COLS:-} ]]; then
    COLS=$GH_SWEEP_COLS
    ROWS=${GH_SWEEP_ROWS:-24}
  else
    size=$(stty size 2>/dev/null || true)
    if [[ $size =~ ^([0-9]+)[[:space:]]([0-9]+)$ ]]; then
      ROWS=${BASH_REMATCH[1]}
      COLS=${BASH_REMATCH[2]}
    else
      ROWS=24
      COLS=80
    fi
  fi
  if ((ROWS < 8)); then
    ROWS=8
  fi
  if ((COLS < 40)); then
    COLS=40
  fi
}

layout_metrics() {
  term_size
  USABLE=$((COLS - 1))
  if ((USABLE < 20)); then
    USABLE=20
  fi
  HEADER_H=3
  if [[ -n $filter && -n $load_note ]]; then
    HEADER_H=4
  fi
  FOOTER_H=3
  WINDOW=$((ROWS - 1 - HEADER_H - FOOTER_H))
  if ((WINDOW < 1)); then
    WINDOW=1
  fi
}

ensure_scroll() {
  local n max
  layout_metrics
  n=${#view_type[@]}
  if ((n == 0)); then
    scroll=0
    return
  fi
  if ((cursor < 0)); then
    cursor=0
  fi
  if ((cursor >= n)); then
    cursor=$((n - 1))
  fi
  if ((cursor < scroll)); then
    scroll=$cursor
  fi
  if ((cursor >= scroll + WINDOW)); then
    scroll=$((cursor - WINDOW + 1))
  fi
  max=$((n - WINDOW))
  if ((max < 0)); then
    max=0
  fi
  if ((scroll > max)); then
    scroll=$max
  fi
  if ((scroll < 0)); then
    scroll=0
  fi
}

screen_reset() {
  screen_lines=()
  screen_kind=()
  screen_color=()
}

add_line() {
  screen_kind+=("$1")
  screen_lines+=("$2")
  if [[ -n ${3-} ]]; then
    screen_color+=("$3")
  else
    screen_color+=("$2")
  fi
}

add_text() {
  local kind=$1 text=$2 plain color
  _fit "$text" "$USABLE"
  plain=$FIT
  color=$plain
  if ((use_color)); then
    case $kind in
      title) color="${C_BCYAN}${plain}${C_RESET}" ;;
      error) color="${C_BRED}${plain}${C_RESET}" ;;
      warn) color="${C_YELLOW}${plain}${C_RESET}" ;;
      good) color="${C_BGREEN}${plain}${C_RESET}" ;;
      dim) color="${C_DIM}${plain}${C_RESET}" ;;
      *) color=$plain ;;
    esac
  fi
  add_line "$kind" "$plain" "$color"
}

add_rule() {
  local rule i color
  if ((unicode)); then
    rule=""
    for ((i = 0; i < USABLE; i++)); do
      rule+="$RULE_CHAR"
    done
  else
    printf -v rule '%*s' "$USABLE" ""
    rule=${rule// /-}
  fi
  color=$rule
  if ((use_color)); then
    color="${C_DIM}${rule}${C_RESET}"
  fi
  add_line "rule" "$rule" "$color"
}

colorize_row() {
  local lead=$1 mark=$2 box=$3 state=$4 lab=$5 gap=$6 right=$7 kind=$8 cur=$9
  local markc boxc labc rightc base
  if [[ $mark == ">" ]]; then
    markc="${C_BCYAN}>${C_RESET}"
  else
    markc=" "
  fi
  boxc=""
  if [[ -n $box ]]; then
    case $state in
      all) boxc="${C_BGREEN}${box}${C_RESET} " ;;
      some) boxc="${C_BYELLOW}${box}${C_RESET} " ;;
      *) boxc="${C_DIM}${box}${C_RESET} " ;;
    esac
  fi
  if [[ $kind == section ]]; then
    labc="${C_BCYAN}${lab}${C_RESET}"
  elif ((cur)); then
    labc="${C_BOLD}${lab}${C_RESET}"
  else
    labc=$lab
  fi
  if [[ $right == *" expired" ]]; then
    base=${right% expired}
    if ((cur)); then
      rightc="${base} ${C_YELLOW}expired${C_RESET}"
    else
      rightc="${C_DIM}${base}${C_RESET} ${C_YELLOW}expired${C_RESET}"
    fi
  elif ((cur)); then
    rightc=$right
  else
    rightc="${C_DIM}${right}${C_RESET}"
  fi
  printf '%s' "${lead}${markc}${boxc}${labc}${gap}${rightc}"
}

make_line() {
  local level=$1 cur=$2 state=$3 label=$4 right=$5 kind=$6
  local nspaces sp mark box prefix pw rw lw lab padn gapn gap plain color lead
  nspaces=$((2 + level * 2))
  printf -v sp '%*s' "$nspaces" ""
  mark=" "
  if ((cur)); then
    mark=">"
  fi
  sp="${sp:0:nspaces-1}${mark}"
  case $state in
    all) box='[x]' ;;
    some) box='[-]' ;;
    none) box='[ ]' ;;
    *) box='' ;;
  esac
  if [[ -n $box ]]; then
    prefix="${sp}${box} "
  else
    prefix=$sp
  fi
  pw=${#prefix}
  rw=${#right}
  lw=$((USABLE - pw - 2 - rw))
  if ((lw < 8)); then
    lw=8
    if ((USABLE - pw - 2 - lw < 0)); then
      right=""
      rw=0
      lw=$((USABLE - pw))
      if ((lw < 1)); then
        lw=1
      fi
    else
      _fit "$right" $((USABLE - pw - 2 - lw))
      right=$FIT
      rw=${#right}
      lw=$((USABLE - pw - 2 - rw))
    fi
  fi
  if ((lw < 1)); then
    lw=1
  fi
  _fit "$label" "$lw"
  lab=$FIT
  padn=$((lw - ${#lab}))
  if ((padn > 0)); then
    printf -v lab '%s%*s' "$lab" "$padn" ""
  fi
  gapn=$((USABLE - pw - ${#lab} - rw))
  if ((gapn < 1)); then
    gapn=1
  fi
  if ((pw + ${#lab} + gapn + rw > USABLE)); then
    gapn=$((USABLE - pw - ${#lab} - rw))
    if ((gapn < 0)); then
      gapn=0
    fi
  fi
  printf -v gap '%*s' "$gapn" ""
  plain="${prefix}${lab}${gap}${right}"
  if ((${#plain} > USABLE)); then
    plain=${plain:0:USABLE}
  fi
  color=$plain
  if ((use_color)); then
    lead=${sp:0:${#sp}-1}
    color=$(colorize_row "$lead" "$mark" "$box" "$state" "$lab" "$gap" "$right" "$kind" "$cur")
  fi
  add_line "row" "$plain" "$color"
}

item_right() {
  local meta=$1 epoch=$2 size=$3 id=$4 expired=$5
  local time meta_f sz idf flag
  time=$(human_time "$epoch")
  _fit "$time" 10
  printf -v time '%-10s' "$FIT"
  _fit "$meta" 14
  printf -v meta_f '%-14s' "$FIT"
  sz=$(human_size "$size")
  _fit "$sz" 8
  printf -v sz '%8s' "$FIT"
  idf="#${id}"
  flag=""
  if [[ $expired == 1 ]]; then
    flag=" expired"
  fi
  if ((USABLE >= 92)); then
    printf '%s %s %s  %s%s' "$meta_f" "$time" "$sz" "$idf" "$flag"
  elif ((USABLE >= 68)); then
    printf '%s %s  %s%s' "$time" "$sz" "$idf" "$flag"
  else
    printf '%s%s' "$sz" "$flag"
  fi
}

section_right() {
  local noun=$1 sz
  sz=$(human_size "$STAT_BYTES")
  if ((STAT_ON > 0)); then
    printf '%d/%d %s%s%s' "$STAT_ON" "$STAT_LIVE" "$noun" "$SEP" "$sz"
  else
    printf '%d %s%s%s' "$STAT_LIVE" "$noun" "$SEP" "$sz"
  fi
}

group_right() {
  local sz
  sz=$(human_size "$STAT_BYTES")
  if ((STAT_ON > 0 && STAT_ON < STAT_LIVE)); then
    printf '%d/%d%s%s' "$STAT_ON" "$STAT_LIVE" "$SEP" "$sz"
  else
    printf '%d%s%s' "$STAT_LIVE" "$SEP" "$sz"
  fi
}

render_view_row() {
  local row=$1 t ref cur=0 label noun right st
  t=${view_type[$row]}
  ref=${view_ref[$row]}
  if ((row == cursor)); then
    cur=1
  fi
  case $t in
    section)
      kind_stats "$ref"
      if [[ $ref == artifact ]]; then
        label=ARTIFACTS
        noun=$(plural_word "$STAT_LIVE" item items)
      else
        label=CACHES
        noun=$(plural_word "$STAT_LIVE" entry entries)
      fi
      right=$(section_right "$noun")
      make_line 0 "$cur" "$STAT_STATE" "$label" "$right" section
      ;;
    group)
      range_stats "${group_start[$ref]}" "${group_len[$ref]}"
      right=$(group_right)
      make_line 1 "$cur" "$STAT_STATE" "${group_name[$ref]}" "$right" group
      ;;
    item)
      right=$(item_right "${item_meta[$ref]}" "${item_epoch[$ref]}" "${item_size[$ref]}" "${item_id[$ref]}" "${item_expired[$ref]}")
      st=none
      if [[ ${item_on[$ref]} == 1 ]]; then
        st=all
      fi
      make_line 2 "$cur" "$st" "${item_name[$ref]}" "$right" item
      ;;
  esac
}

compose_header() {
  local plain raw_len color info shown
  plain="gh-sweep  ${repo_nwo_full}"
  if ((dry_run)); then
    plain+="   dry-run"
  fi
  raw_len=${#plain}
  _fit "$plain" "$USABLE"
  plain=$FIT
  color=$plain
  if ((use_color)); then
    if ((raw_len <= USABLE)); then
      color="${C_BCYAN}gh-sweep${C_RESET}  ${C_BOLD}${repo_nwo_full}${C_RESET}"
      if ((dry_run)); then
        color+="   ${C_YELLOW}dry-run${C_RESET}"
      fi
    else
      color="${C_BOLD}${plain}${C_RESET}"
    fi
  fi
  add_line "title" "$plain" "$color"
  if [[ -n $filter && -n $load_note ]]; then
    shown=$(count_shown)
    info="/ ${filter}"
    if ((filter_edit)); then
      info+="_"
    fi
    info+="${SEP}${shown} shown"
    add_text plain "$info"
    add_text warn "$load_note"
    return
  fi
  if [[ -n $filter ]]; then
    shown=$(count_shown)
    info="/ ${filter}"
    if ((filter_edit)); then
      info+="_"
    fi
    info+="${SEP}${shown} shown"
    add_text plain "$info"
  elif [[ -n $load_note ]]; then
    add_text warn "$load_note"
  else
    info=$(counts_line)
    add_text dim "$info"
  fi
  add_line "blank" "" ""
}

pos_text() {
  local n first last
  n=${#view_type[@]}
  if ((n == 0)); then
    printf ''
    return
  fi
  first=$((scroll + 1))
  last=$((scroll + WINDOW))
  if ((last > n)); then
    last=$n
  fi
  printf '%d-%d of %d' "$first" "$last" "$n"
}

keys_line() {
  if ((filter_edit)); then
    printf '%s' "type to filter    enter done    esc clear    arrows move"
    return
  fi
  if [[ -n $filter ]]; then
    printf '%s' "esc clears filter    space select    d delete    q quit"
    return
  fi
  if ((unicode)); then
    printf '%s' "space select    ↑↓ move    b projects    d delete    t trim    x expired    / find    q quit"
  else
    printf '%s' "space select    j/k move    b projects    d delete    t trim    x expired    / find    q quit"
  fi
}

compose_footer() {
  local sum pos line gapn gap keys color room
  sum=$(summary_text)
  pos=""
  if [[ $mode == list ]]; then
    pos=$(pos_text)
  fi
  if [[ -n $pos ]]; then
    room=$((USABLE - ${#pos} - 2))
    if ((room > 10 && ${#sum} <= room)); then
      gapn=$((USABLE - ${#sum} - ${#pos}))
      printf -v gap '%*s' "$gapn" ""
      line="${sum}${gap}${pos}"
    else
      _fit "$sum" "$USABLE"
      line=$FIT
    fi
  else
    _fit "$sum" "$USABLE"
    line=$FIT
  fi
  color=$line
  if ((use_color)); then
    if [[ -n $status_msg ]]; then
      color="${C_YELLOW}${line}${C_RESET}"
    elif ((SEL_COUNT > 0)); then
      color="${C_BOLD}${line}${C_RESET}"
    else
      color="${C_DIM}${line}${C_RESET}"
    fi
  fi
  add_line "summary" "$line" "$color"
  keys=$(keys_line)
  _fit "$keys" "$USABLE"
  keys=$FIT
  color=$keys
  if ((use_color)); then
    color="${C_DIM}${keys}${C_RESET}"
  fi
  add_line "keys" "$keys" "$color"
}

compose_empty() {
  if ((fatal_load)); then
    add_text error "Could not load this repository."
    if [[ -n $art_error ]]; then
      add_text plain "  $art_error"
    fi
    if [[ -n $cache_error ]]; then
      add_text plain "  $cache_error"
    fi
    add_line "blank" "" ""
    add_text dim "r retries    q quits"
    return
  fi
  if [[ -n $filter ]]; then
    add_text plain "No matches for \"${filter}\"."
    add_text dim "esc clears the filter"
    return
  fi
  if [[ -n $art_error || -n $cache_error ]]; then
    add_text warn "Part of the list failed to load."
    if [[ -n $art_error ]]; then
      add_text plain "  $art_error"
    fi
    if [[ -n $cache_error ]]; then
      add_text plain "  $cache_error"
    fi
    return
  fi
  add_text plain "Nothing to clean."
  add_text dim "This repository has no Actions artifacts or caches."
}

trim_last_line() {
  local last
  if ((${#screen_lines[@]} == 0)); then
    return
  fi
  last=$((${#screen_lines[@]} - 1))
  unset "screen_lines[$last]"
  unset "screen_kind[$last]"
  unset "screen_color[$last]"
}

compose_list_body() {
  local i row n
  compose_header
  n=${#view_type[@]}
  if ((n == 0)); then
    compose_empty
  else
    for ((i = 0; i < WINDOW; i++)); do
      row=$((scroll + i))
      if ((row >= n)); then
        add_line "blank" "" ""
      else
        render_view_row "$row"
      fi
    done
  fi
  while ((${#screen_lines[@]} < HEADER_H + WINDOW)); do
    add_line "blank" "" ""
  done
  while ((${#screen_lines[@]} > HEADER_H + WINDOW)); do
    trim_last_line
  done
  add_rule
  compose_footer
}

confirm_group_line() {
  local g=$1 on=0 bytes=0 i start end nm sz line
  start=${group_start[$g]}
  end=$((start + group_len[$g]))
  for ((i = start; i < end; i++)); do
    if [[ ${item_dead[$i]} == 1 || ${item_on[$i]} != 1 ]]; then
      continue
    fi
    on=$((on + 1))
    bytes=$((bytes + ${item_size[$i]}))
  done
  if ((on == 0)); then
    CONFIRM_HIT=0
    return
  fi
  CONFIRM_HIT=1
  nm=$(fit_print "${group_name[$g]}" 36)
  sz=$(human_size "$bytes")
  printf -v line '  %-36s  %4d   %s' "$nm" "$on" "$sz"
  CONFIRM_LINE=$line
  CONFIRM_KIND=${group_kind[$g]}
}

compose_confirm() {
  local g shown=0 hidden_groups=0 max_groups last_kind="" line
  if [[ $confirm_scope == projects ]]; then
    compose_confirm_projects
    return
  fi
  count_selected
  if ((confirm_strict)); then
    add_text error "Large delete from ${repo_nwo_full}"
  else
    add_text error "Delete from ${repo_nwo_full}"
  fi
  add_line "blank" "" ""
  if ((dry_run)); then
    add_text warn "Dry run: nothing will be deleted."
  elif ((confirm_strict)); then
    add_text plain "This permanently deletes ${SEL_COUNT} selected items ($(human_size "$SEL_BYTES"))."
    add_text plain "Type the repository name to confirm. GitHub cannot undo it."
  else
    add_text plain "This permanently deletes the selection. GitHub cannot undo it."
  fi
  add_line "blank" "" ""
  max_groups=$((ROWS - 16))
  if ((max_groups < 3)); then
    max_groups=3
  fi
  if ((${#art_groups[@]} > 0)); then
    for g in "${art_groups[@]}"; do
      confirm_group_line "$g"
      if ((CONFIRM_HIT == 0)); then
        continue
      fi
      if ((shown >= max_groups)); then
        hidden_groups=$((hidden_groups + 1))
        continue
      fi
      if [[ $CONFIRM_KIND != "$last_kind" ]]; then
        add_text title "ARTIFACTS"
        last_kind=$CONFIRM_KIND
      fi
      add_text plain "$CONFIRM_LINE"
      shown=$((shown + 1))
    done
  fi
  if ((${#cache_groups[@]} > 0)); then
    for g in "${cache_groups[@]}"; do
      confirm_group_line "$g"
      if ((CONFIRM_HIT == 0)); then
        continue
      fi
      if ((shown >= max_groups)); then
        hidden_groups=$((hidden_groups + 1))
        continue
      fi
      if [[ $CONFIRM_KIND != "$last_kind" ]]; then
        add_text title "CACHES"
        last_kind=$CONFIRM_KIND
      fi
      add_text plain "$CONFIRM_LINE"
      shown=$((shown + 1))
    done
  fi
  if ((hidden_groups > 0)); then
    if ((unicode)); then
      add_text dim "  … ${hidden_groups} more"
    else
      add_text dim "  ... ${hidden_groups} more"
    fi
  fi
  add_line "blank" "" ""
  printf -v line 'Total  %d   %s' "$SEL_COUNT" "$(human_size "$SEL_BYTES")"
  add_text plain "$line"
  add_line "blank" "" ""
  if ((confirm_strict)); then
    add_text plain "Type ${name} or ${repo_nwo_full}"
    add_text plain "> ${confirm_buf}_"
    add_text dim "enter confirms    esc cancels"
  else
    if ((dry_run)); then
      add_text plain "y   finish the dry run"
    else
      add_text error "y   delete now"
    fi
    add_text dim "n   go back"
  fi
  if [[ -n $status_msg ]]; then
    add_line "blank" "" ""
    add_text warn "$status_msg"
  fi
}

compose_result() {
  local f shown=0 where
  where=${RESULT_WHERE:-$repo_nwo_full}
  if ((dry_run)); then
    add_text warn "Dry run for ${where}"
    add_line "blank" "" ""
    add_text plain "No delete requests were sent."
  elif ((RESULT_ABORT)); then
    add_text warn "Stopped early on ${where}"
    add_line "blank" "" ""
    add_text plain "Some selected items were not deleted."
  elif ((RESULT_FAILS > 0 && RESULT_ART + RESULT_CACHE == 0)); then
    add_text error "Nothing deleted on ${where}"
  else
    add_text good "Deleted from ${where}"
  fi
  add_line "blank" "" ""
  add_text plain "  ${RESULT_ART} $(plural_word "$RESULT_ART" artifact artifacts)"
  add_text plain "  ${RESULT_CACHE} $(plural_word "$RESULT_CACHE" cache caches)"
  add_text plain "  freed $(human_size "$RESULT_BYTES")"
  if ((RESULT_FAILS > 0 && ${#fail_lines[@]} > 0)); then
    add_line "blank" "" ""
    add_text error "Failed"
    for f in "${fail_lines[@]}"; do
      if ((shown >= 8)); then
        add_text dim "  ... $((RESULT_FAILS - shown)) more"
        break
      fi
      add_text plain "  $f"
      shown=$((shown + 1))
    done
  fi
  add_line "blank" "" ""
  add_text dim "Artifact quota usage refreshes every 6-12 hours."
  add_text dim "q quits    any other key goes back"
}

compose_working() {
  local width=24 filled=0 i marks=""
  add_text title "Deleting ${WORK_INDEX} of ${WORK_TOTAL}"
  add_line "blank" "" ""
  add_text plain "$WORK_LABEL"
  add_text dim "$WORK_DETAIL"
  add_line "blank" "" ""
  if ((WORK_TOTAL > 0)); then
    filled=$((WORK_INDEX * width / WORK_TOTAL))
  fi
  if ((filled > width)); then
    filled=$width
  fi
  for ((i = 0; i < filled; i++)); do
    marks+="#"
  done
  for ((i = filled; i < width; i++)); do
    marks+="-"
  done
  add_text plain "[${marks}]"
  add_line "blank" "" ""
  add_text plain "freed $(human_size "$WORK_FREED")    failed ${WORK_FAILS}"
  if [[ -n $WORK_NOTE ]]; then
    add_text warn "$WORK_NOTE"
  fi
  add_line "blank" "" ""
  add_text dim "ctrl-c stops after the current request"
}

compose_prompt() {
  add_text title "$prompt_title"
  add_line "blank" "" ""
  add_text plain "> ${prompt_buf}_"
  add_line "blank" "" ""
  if [[ $prompt_kind == add ]]; then
    add_text dim "Type owner/repo. Enter adds it. Esc cancels."
  elif [[ $prompt_kind == keep ]]; then
    add_text dim "Enter applies. 0 selects every artifact. Esc cancels."
    add_text dim "Newer copies of each name stay unchecked."
  else
    add_text dim "Numbers only. Enter applies. Esc cancels."
    add_text dim "Matching artifacts are added to the current selection."
  fi
}

compose_help() {
  local line count=0 limit
  add_text title "gh-sweep help"
  add_line "blank" "" ""
  limit=$((ROWS - 5))
  if ((limit < 4)); then
    limit=4
  fi
  local lines
  lines=()
  lines+=("Projects: space marks a repo for a full wipe, enter opens it.")
  lines+=("d on the project list deletes everything marked.")
  lines+=("b returns from a project to that list. + adds owner/repo.")
  lines+=("")
  lines+=("space      toggle the highlighted row")
  lines+=("enter      toggle an item, or open and close a group")
  lines+=("j/k        move        h/l fold        e/c fold all")
  lines+=("a/n        select or clear what the filter shows")
  lines+=("x          select expired artifacts (they still use quota)")
  lines+=("o          select artifacts older than N days")
  lines+=("t          keep the newest N of each name, select the rest")
  lines+=("d          delete       / filter       r refresh")
  lines+=("?          help         q quit")
  lines+=("")
  lines+=("A group checkbox selects every artifact of that name,")
  lines+=("or every cache entry with that key.")
  lines+=("Deletes run largest-first. Quota usage refreshes in 6-12 hours.")
  for line in "${lines[@]}"; do
    if ((count >= limit)); then
