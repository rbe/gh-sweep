    else
      add_text plain "$line"
    fi
    count=$((count + 1))
  done
  add_line "blank" "" ""
  add_text dim "press a key to return     q quits"
}

pad_screen() {
  while ((${#screen_lines[@]} < ROWS - 1)); do
    add_line "blank" "" ""
  done
  while ((${#screen_lines[@]} > ROWS - 1)); do
    trim_last_line
  done
}

compose_screen() {
  screen_reset
  layout_metrics
  case $mode in
    projects) compose_projects ;;
    confirm) compose_confirm ;;
    result) compose_result ;;
    help) compose_help ;;
    prompt) compose_prompt ;;
    working) compose_working ;;
    *) compose_list_body ;;
  esac
  pad_screen
  if [[ -n ${GH_SWEEP_DUMP:-} ]]; then
    {
      printf '%s\n' "---FRAME ${mode}---"
      local i
      for ((i = 0; i < ${#screen_lines[@]}; i++)); do
        printf '%s\n' "${screen_lines[$i]}"
      done
    } >> "$GH_SWEEP_DUMP"
  fi
}

draw() {
  local n limit i line
  compose_screen
  if (( ! in_alt )); then
    return 0
  fi
  printf '\033[H'
  n=${#screen_lines[@]}
  limit=$((ROWS - 1))
  if ((n > limit)); then
    n=$limit
  fi
  for ((i = 0; i < n; i++)); do
    if ((use_color)); then
      line=${screen_color[$i]}
    else
      line=${screen_lines[$i]}
    fi
    printf '\033[2K%s' "$line"
    if ((i < n - 1)); then
      printf '\n'
    fi
  done
  printf '\033[J'
}

draw_loading() {
  local msg=$1
  if (( ! in_alt )); then
    return 0
  fi
  printf '\033[H\033[J'
  printf '\n  gh-sweep  %s\n\n  %s\n' "$repo_nwo_full" "$msg"
  printf '  Large repositories can take a moment.\n'
}

# --- keyboard ------------------------------------------------------------

read_paste() {
  local acc="" b n=0
  PASTE=""
  while IFS= read -rsd '' -n1 b; do
    acc+="$b"
    n=$((n + 1))
    if [[ $acc == *$'\e[201~' ]]; then
      PASTE=${acc%$'\e[201~'}
      return 0
    fi
    if ((n > 400)); then
      PASTE=""
      return 0
    fi
  done
  return 1
}

read_key() {
  local b c saved seq n
  IFS= read -rsd '' -n1 b || return 1
  if [[ $b != $'\e' ]]; then
    KEY=$b
    return 0
  fi
  saved=$(stty -g)
  stty -echo -icanon min 0 time 1 || true
  c=$(dd bs=1 count=1 2>/dev/null || true)
  if [[ -z $c ]]; then
    stty "$saved" 2>/dev/null || stty -echo -icanon min 1 time 0 || true
    KEY=$'\e'
    return 0
  fi
  seq=$c
  if [[ $c == '[' || $c == 'O' ]]; then
    n=0
    while ((n < 8)); do
      c=$(dd bs=1 count=1 2>/dev/null || true)
      if [[ -z $c ]]; then
        break
      fi
      seq+="$c"
      n=$((n + 1))
      case $c in
        [A-Za-z~]) break ;;
      esac
    done
  fi
  stty "$saved" 2>/dev/null || stty -echo -icanon min 1 time 0 || true
  KEY=$'\e'"$seq"
  if [[ $KEY == $'\e[200~' ]]; then
    read_paste || true
  fi
  return 0
}

is_printable() {
  local k=$1
  [[ ${#k} -eq 1 ]] || return 1
  case $k in
    [[:cntrl:]]) return 1 ;;
    *) return 0 ;;
  esac
}

apply_filter_change() {
  filter_l=$(printf '%s' "$filter" | tr '[:upper:]' '[:lower:]')
  update_view_keep_cursor
}

filter_backspace() {
  if [[ -z $filter ]]; then
    return
  fi
  filter=${filter%?}
  apply_filter_change
}

filter_delete_word() {
  local s=$filter
  while [[ $s == *" " ]]; do
    s=${s% }
  done
  if [[ $s == *" "* ]]; then
    s=${s% *}
    while [[ $s == *" " ]]; do
      s=${s% }
    done
  else
    s=""
  fi
  filter=$s
  apply_filter_change
}

append_paste_to_filter() {
  local rest=$PASTE ch
  while [[ -n $rest ]]; do
    ch=${rest:0:1}
    rest=${rest:1}
    if is_printable "$ch"; then
      filter+="$ch"
    fi
  done
  apply_filter_change
}

move() {
  local dir=$1 wrap=${2:-1} n i
  n=${#view_type[@]}
  if ((n <= 0)); then
    return
  fi
  i=$cursor
  if ((i < 0)); then
    i=0
  fi
  if ((i >= n)); then
    i=$((n - 1))
  fi
  i=$((i + dir))
  if ((i < 0)); then
    if ((wrap)); then
      i=$((n - 1))
    else
      i=0
    fi
  elif ((i >= n)); then
    if ((wrap)); then
      i=0
    else
      i=$((n - 1))
    fi
  fi
  cursor=$i
  ensure_scroll
}

page_move() {
  local dir=$1 win i before
  layout_metrics
  win=$WINDOW
  if ((win < 1)); then
    win=1
  fi
  for ((i = 0; i < win; i++)); do
    before=$cursor
    move "$dir" 0
    if ((cursor == before)); then
      break
    fi
  done
}

go_home() {
  cursor=0
  ensure_scroll
}

go_end() {
  local n=${#view_type[@]}
  if ((n > 0)); then
    cursor=$((n - 1))
  else
    cursor=0
  fi
  ensure_scroll
}

current_group() {
  local n=${#view_type[@]} t r
  if ((n == 0 || cursor < 0 || cursor >= n)); then
    return 1
  fi
  t=${view_type[$cursor]}
  r=${view_ref[$cursor]}
  case $t in
    group) printf '%s' "$r" ;;
    item) printf '%s' "${item_group[$r]}" ;;
    *) return 1 ;;
  esac
}

open_current() {
  local g
  if ! g=$(current_group); then
    return
  fi
  group_open[$g]=1
  update_view_keep_cursor
}

close_current() {
  local g
  if ! g=$(current_group); then
    return
  fi
  group_open[$g]=0
  build_view
  place_cursor group "$g"
  ensure_scroll
}

set_all_open() {
  local v=$1 g
  if ((${#group_kind[@]} == 0)); then
    return
  fi
  for ((g = 0; g < ${#group_kind[@]}; g++)); do
    group_open[$g]=$v
  done
  update_view_keep_cursor
}

enter_current() {
  local n=${#view_type[@]} t r
  if ((n == 0)); then
    return
  fi
  t=${view_type[$cursor]}
  r=${view_ref[$cursor]}
  if [[ $t == group ]]; then
    if [[ ${group_open[$r]} == 1 ]]; then
      group_open[$r]=0
    else
      group_open[$r]=1
    fi
    update_view_keep_cursor
  else
    toggle_current
  fi
}

begin_prompt() {
  prompt_kind=older
  prompt_from=list
  mode=prompt
  prompt_buf=""
  prompt_title="Select artifacts older than how many days?"
  status_msg=""
}

begin_keep_prompt() {
  prompt_kind=keep
  prompt_from=list
  mode=prompt
  prompt_buf=""
  prompt_title="Keep how many of the newest artifacts of each name?"
  status_msg=""
}

begin_add_prompt() {
  prompt_kind=add
  prompt_from=projects
  mode=prompt
  prompt_buf=""
  prompt_title="Add a repository"
  status_msg=""
}

begin_confirm() {
  count_selected
  if ((SEL_COUNT == 0)); then
    status_msg="Nothing selected"
    return
  fi
  confirm_scope=items
  return_mode=list
  mode=confirm
  confirm_buf=""
  status_msg=""
  confirm_token=$name
  if ((SEL_COUNT > STRICT_COUNT || SEL_BYTES >= STRICT_BYTES)); then
    confirm_strict=1
  else
    confirm_strict=0
  fi
}

handle_filter_edit_key() {
  local key=$1
  status_msg=""
  case $key in
    $'\r'|$'\n') filter_edit=0 ;;
    $'\e')
      filter=""
      filter_edit=0
      apply_filter_change
      ;;
    $'\x7f'|$'\b'|$'\e[3~') filter_backspace ;;
    $'\x15')
      filter=""
      apply_filter_change
      ;;
    $'\x17') filter_delete_word ;;
    $'\e[A'|$'\eOA') move -1 ;;
    $'\e[B'|$'\eOB') move 1 ;;
    $'\e[C'|$'\eOC') open_current ;;
    $'\e[D'|$'\eOD') close_current ;;
    $'\e[200~') append_paste_to_filter ;;
    *)
      if is_printable "$key"; then
        filter+="$key"
        apply_filter_change
      fi
      ;;
  esac
}

handle_prompt_key() {
  local key=$1 days
  if [[ $prompt_kind == add ]]; then
    case $key in
      $'\r'|$'\n')
        if add_project "$prompt_buf"; then
          rebuild_proj_view
          status_msg="Added ${repo_nwo_full}"
        else
          status_msg="Not a repository: ${prompt_buf}"
        fi
        mode=projects
        ;;
      $'\e'|q|Q)
        mode=projects
        ;;
      $'\x7f'|$'\b')
        prompt_buf=${prompt_buf%?}
        ;;
      *)
        if is_printable "$key" && ((${#prompt_buf} < 200)); then
          prompt_buf+="$key"
        fi
        ;;
    esac
    return
  fi
  case $key in
    $'\r'|$'\n')
      if [[ $prompt_buf =~ ^[0-9]+$ ]]; then
        days=$((10#$prompt_buf))
        mode=list
        if [[ $prompt_kind == keep ]]; then
          select_except_newest "$days"
        else
          select_older "$days"
        fi
      else
        mode=list
        status_msg="Not a number of days"
      fi
      ;;
    $'\e'|q|Q)
      mode=$prompt_from
      ;;
    $'\x7f'|$'\b')
      prompt_buf=${prompt_buf%?}
      ;;
    [0-9])
      if ((${#prompt_buf} < 5)); then
        prompt_buf+="$key"
      fi
      ;;
  esac
}

confirm_accepted() {
  if [[ $confirm_buf == "$confirm_token" ]]; then
    return 0
  fi
  if [[ $confirm_scope == items && $confirm_buf == "$repo_nwo_full" ]]; then
    return 0
  fi
  return 1
}

run_confirmed_delete() {
  if [[ $confirm_scope == projects ]]; then
    perform_project_wipes
  else
    perform_deletes
  fi
}

handle_confirm_key() {
  local key=$1
  status_msg=""
  if ((confirm_strict)); then
    case $key in
      $'\r'|$'\n')
        if confirm_accepted; then
          run_confirmed_delete
        else
          status_msg="Type ${confirm_token} to confirm"
        fi
        ;;
      $'\e'|q|Q)
        mode=$return_mode
        ;;
      $'\x7f'|$'\b')
        confirm_buf=${confirm_buf%?}
        ;;
      *)
        if is_printable "$key" && ((${#confirm_buf} < 200)); then
          confirm_buf+="$key"
        fi
        ;;
    esac
    return
  fi
  case $key in
    y|Y) run_confirmed_delete ;;
    n|N|$'\e'|q|Q|$'\r'|$'\n') mode=$return_mode ;;
  esac
}

handle_list_key() {
  local key=$1
  status_msg=""
  case $key in
    $'\e[A'|$'\eOA'|k) move -1 ;;
    $'\e[B'|$'\eOB'|j) move 1 ;;
    $'\e[5~'|$'\x15'|K) page_move -1 ;;
    $'\e[6~'|$'\x04'|J) page_move 1 ;;
    $'\e[H'|$'\e[1~'|$'\eOH'|g) go_home ;;
    $'\e[F'|$'\e[4~'|$'\eOF'|G) go_end ;;
    $'\e[C'|$'\eOC'|l) open_current ;;
    $'\e[D'|$'\eOD'|h) close_current ;;
    ' ') toggle_current ;;
    $'\r'|$'\n') enter_current ;;
    e) set_all_open 1 ;;
    c) set_all_open 0 ;;
    a) select_visible 1 "" ;;
    A) select_visible 1 artifact ;;
    C) select_visible 1 cache ;;
    n) select_visible 0 "" ;;
    N) clear_all_selection ;;
    x) select_expired ;;
    o) begin_prompt ;;
    t) begin_keep_prompt ;;
    d) begin_confirm ;;
    b) back_to_projects ;;
    /) filter_edit=1 ;;
    r) refresh_data ;;
    '?'|$'\eOP'|$'\e[11~')
      help_from=list
      mode=help
      ;;
    q|Q) QUIT=1 ;;
    $'\x7f'|$'\b')
      if [[ -n $filter ]]; then
        filter_edit=1
        filter_backspace
      fi
      ;;
    $'\e')
      if [[ -n $filter ]]; then
        filter=""
        filter_edit=0
        apply_filter_change
      fi
      ;;
    $'\e[200~') ;;
  esac
}

handle_key() {
  local key=$KEY
  if [[ -n ${GH_SWEEP_LOG:-} ]]; then
    printf 'KEY %q mode=%s\n' "$key" "$mode" >> "$GH_SWEEP_LOG"
  fi
  case $mode in
    help)
      if [[ $key == q || $key == Q ]]; then
        QUIT=1
      else
        mode=$help_from
      fi
      return
      ;;
    result)
      if [[ $key == q || $key == Q ]]; then
        QUIT=1
      fi
      mode=$return_mode
      return
      ;;
    prompt)
      handle_prompt_key "$key"
      return
      ;;
    confirm)
      handle_confirm_key "$key"
      return
      ;;
    working)
      return
      ;;
    projects)
      if ((proj_filter_edit)); then
        handle_proj_filter_key "$key"
      else
        handle_project_key "$key"
      fi
      return
      ;;
  esac
  if ((filter_edit)); then
    handle_filter_edit_key "$key"
    return
  fi
  handle_list_key "$key"
}

# --- GitHub --------------------------------------------------------------

artifact_jq() {
  cat <<'EOF'
def clean:
  if type == "string" then
    gsub("\t"; " ") | gsub("\r"; " ") | gsub("\n"; " ") | gsub("\u001f"; " ")
  else
    .
  end;
"T \(.total_count | tostring)",
(
  .artifacts[]?
  | [
      (.id | tostring),
      ((.name // "") | clean),
      ((.size_in_bytes // 0) | tostring),
      (.created_at // ""),
      (if .expired then "1" else "0" end),
      (((.workflow_run // {}) | .head_branch // "") | clean),
      (((.workflow_run // {}) | .id // 0) | tostring)
    ]
  | join("\u001f")
)
EOF
}

cache_jq() {
  cat <<'EOF'
def clean:
  if type == "string" then
    gsub("\t"; " ") | gsub("\r"; " ") | gsub("\n"; " ") | gsub("\u001f"; " ")
  else
    .
  end;
.[]?
| [
    (.id | tostring),
    ((.key // "") | clean),
    ((.sizeInBytes // 0) | tostring),
    (.createdAt // ""),
    ((.ref // "") | clean),
    (.lastAccessedAt // "")
  ]
| join("\u001f")
EOF
}

read_err() {
  local s=""
  if [[ -s $tmpdir/fetch.err ]]; then
    IFS= read -r s < "$tmpdir/fetch.err" || true
    s=${s#gh: }
    s=$(strip_controls "$s")
  fi
  if [[ -z $s ]]; then
    s="request failed"
  fi
  printf '%s' "$s"
}

fetch_text() {
  local which=$1 errf="$tmpdir/fetch.err" out
  : > "$errf"
  if [[ $which == art ]]; then
    if [[ -n $api_hostname ]]; then
      if ! out=$(gh api --hostname "$api_hostname" --paginate \
        -H "Accept: application/vnd.github+json" \
        "repos/${owner}/${name}/actions/artifacts?per_page=100" \
        --jq "$(artifact_jq)" </dev/null 2>"$errf"); then
        return 1
      fi
    else
      if ! out=$(gh api --paginate \
        -H "Accept: application/vnd.github+json" \
        "repos/${owner}/${name}/actions/artifacts?per_page=100" \
        --jq "$(artifact_jq)" </dev/null 2>"$errf"); then
        return 1
      fi
    fi
  else
    if ! out=$(gh cache list -R "$repo_nwo_full" --limit "$CACHE_CAP" \
      --sort size_in_bytes --order desc \
      --json id,key,ref,sizeInBytes,createdAt,lastAccessedAt \
      --jq "$(cache_jq)" </dev/null 2>"$errf"); then
      return 1
    fi
  fi
  FETCH_OUT=$out
  return 0
}

first_load() {
  local a_ok=1 c_ok=1 a_out="" c_out="" a_err="" c_err="" any=0
  fatal_load=0
  art_error=""
  cache_error=""
  if ((want_art)); then
    draw_loading "Fetching artifacts…"
    if fetch_text art; then
      a_out=$FETCH_OUT
      any=1
    else
      a_ok=0
      a_err=$(read_err)
    fi
  fi
  if ((want_cache)); then
    draw_loading "Fetching caches…"
    if fetch_text cache; then
      c_out=$FETCH_OUT
      any=1
    else
      c_ok=0
      c_err=$(read_err)
    fi
  fi
  if ((any == 0)); then
    fatal_load=1
    art_error=${a_err:-could not list artifacts}
    cache_error=${c_err:-could not list caches}
    if (( ! want_art )); then
      art_error=""
    fi
    if (( ! want_cache )); then
      cache_error=""
    fi
    return 1
  fi
  ART_RAW=$a_out
  CACHE_RAW=$c_out
  art_error=""
  cache_error=""
  if ((want_art && a_ok == 0)); then
    art_error=${a_err:-could not list artifacts}
  fi
  if ((want_cache && c_ok == 0)); then
    cache_error=${c_err:-could not list caches}
  fi
  apply_streams
  return 0
}

save_selection() {
  local i
  saved_sel=()
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_on[$i]} == 1 && ${item_dead[$i]} != 1 ]]; then
      saved_sel+=("${item_kind[$i]}:${item_id[$i]}")
    fi
  done
}

restore_selection() {
  local i k s
  if ((${#saved_sel[@]} == 0)); then
    return
  fi
  for ((i = 0; i < n_items; i++)); do
    k="${item_kind[$i]}:${item_id[$i]}"
    for s in "${saved_sel[@]}"; do
      if [[ $s == "$k" ]]; then
        item_on[$i]=1
        break
      fi
    done
  done
}

save_open() {
  local g
  saved_open=()
  if ((${#group_kind[@]} == 0)); then
    return
  fi
  for ((g = 0; g < ${#group_kind[@]}; g++)); do
    if [[ ${group_open[$g]} == 1 ]]; then
      saved_open+=("${group_kind[$g]}:${group_name[$g]}")
    fi
  done
}

restore_open() {
  local g k s
  if ((${#saved_open[@]} == 0 || ${#group_kind[@]} == 0)); then
    return
  fi
  for ((g = 0; g < ${#group_kind[@]}; g++)); do
    k="${group_kind[$g]}:${group_name[$g]}"
    for s in "${saved_open[@]}"; do
      if [[ $s == "$k" ]]; then
        group_open[$g]=1
        break
      fi
    done
  done
}

save_anchor() {
  local n=${#view_type[@]} t r
  anchor_kind=""
  anchor_id=""
  anchor_group=""
  if ((n == 0 || cursor < 0 || cursor >= n)); then
    return
  fi
  t=${view_type[$cursor]}
  r=${view_ref[$cursor]}
  case $t in
    section) anchor_kind="section:${r}" ;;
    group)
      anchor_kind="group"
      anchor_group="${group_kind[$r]}:${group_name[$r]}"
      ;;
    item)
      anchor_kind="item"
      anchor_id="${item_kind[$r]}:${item_id[$r]}"
      ;;
  esac
}

restore_anchor() {
  local i
  case $anchor_kind in
    section:*)
      place_cursor section "${anchor_kind#section:}"
      ;;
    group)
      if ((${#group_kind[@]} > 0)); then
        for ((i = 0; i < ${#group_kind[@]}; i++)); do
          if [[ ${group_kind[$i]}:${group_name[$i]} == "$anchor_group" ]]; then
            place_cursor group "$i"
            ensure_scroll
            return
          fi
        done
      fi
      place_cursor "" ""
      ;;
    item)
      for ((i = 0; i < n_items; i++)); do
        if [[ ${item_kind[$i]}:${item_id[$i]} == "$anchor_id" ]]; then
          place_cursor item "$i"
          ensure_scroll
          return
        fi
      done
      place_cursor "" ""
      ;;
    *)
      place_cursor "" ""
      ;;
  esac
  ensure_scroll
}

refresh_data() {
  local na="" nc=""
  save_anchor
  save_selection
  save_open
  draw_loading "Refreshing…"
  if ((want_art)); then
    if ! fetch_text art; then
      status_msg="Refresh failed: $(read_err)"
      return
    fi
    na=$FETCH_OUT
  fi
  if ((want_cache)); then
    if ! fetch_text cache; then
      status_msg="Refresh failed: $(read_err)"
      return
    fi
    nc=$FETCH_OUT
  fi
  ART_RAW=$na
  CACHE_RAW=$nc
  art_error=""
  cache_error=""
  fatal_load=0
  apply_streams
  restore_selection
  restore_open
  build_view
  restore_anchor
  ensure_scroll
  if ((open_proj >= 0)); then
    printf '%s\n' "$ART_RAW" > "$(proj_art_file "$open_proj")"
    printf '%s\n' "$CACHE_RAW" > "$(proj_cache_file "$open_proj")"
    : > "$(proj_skip_file "$open_proj")"
    SKIP_SET="|"
    record_project_stats "$open_proj"
  fi
  status_msg="Refreshed"
}

rate_limited() {
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case $s in
    *rate\ limit*|*"http 429"*|*"http 502"*|*"http 503"*|*"http 504"*) return 0 ;;
    *) return 1 ;;
  esac
}

sleep_retry() {
  local t=$1
  if [[ -n ${RETRY_SLEEP+x} ]]; then
    t=$RETRY_SLEEP
  fi
  if [[ $t == 0 || $t == 0.* ]]; then
    return 0
  fi
  sleep "$t" || true
}

run_gh() {
  local attempt=0 waitn=2 out
  GH_OUT=""
  while true; do
    if ((ABORT)); then
      GH_OUT="stopped"
      return 1
    fi
    if out=$("$@" </dev/null 2>&1); then
      GH_OUT=$out
      return 0
    fi
    GH_OUT=$out
    if ((ABORT)); then
      return 1
    fi
    if rate_limited "$out" && ((attempt < 5)); then
      attempt=$((attempt + 1))
      WORK_NOTE="Rate limited, waiting ${waitn}s"
      draw || true
      sleep_retry "$waitn" || true
      if ((waitn < 16)); then
        waitn=$((waitn * 2))
      fi
      continue
    fi
    return 1
  done
}

clean_err() {
  local s=$1
  s=${s#gh: }
  s=${s%%$'\n'*}
  s=$(strip_controls "$s")
  if [[ -z $s ]]; then
    s="request failed"
  fi
  fit_print "$s" 48
}

delete_artifact() {
  local id=$1
  if ((dry_run)); then
    GH_OUT=""
    return 0
  fi
  if [[ ! $id =~ ^[0-9]+$ ]]; then
    GH_OUT="bad artifact id"
    return 1
  fi
  if [[ -n $api_hostname ]]; then
    run_gh gh api --hostname "$api_hostname" -X DELETE \
      "repos/${owner}/${name}/actions/artifacts/${id}"
  else
    run_gh gh api -X DELETE \
      "repos/${owner}/${name}/actions/artifacts/${id}"
  fi
}

delete_cache() {
  local id=$1
  if ((dry_run)); then
    GH_OUT=""
    return 0
  fi
  if [[ ! $id =~ ^[0-9]+$ ]]; then
    GH_OUT="bad cache id"
    return 1
  fi
  run_gh gh cache delete -R "$repo_nwo_full" "$id"
}

sort_work_by_size() {
  local idx line size id
  local sorted
  sorted=()
  if ((${#work_sel[@]} == 0)); then
    return
  fi
  : > "$tmpdir/wsort"
  for idx in "${work_sel[@]}"; do
    printf '%s\t%s\n' "${item_size[$idx]}" "$idx" >> "$tmpdir/wsort"
  done
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line ]] && continue
    IFS=$'\t' read -r size id <<< "$line"
    [[ -n ${id:-} ]] || continue
    sorted+=("$id")
  done < <(LC_ALL=C sort -t $'\t' -k1,1nr -k2,2n "$tmpdir/wsort")
  if ((${#sorted[@]} > 0)); then
    work_sel=("${sorted[@]}")
  fi
}

note_session_repo() {
  case ",${session_repo_list}," in
    *",${repo_nwo_full},"*) ;;
    *) session_repo_list+="${session_repo_list:+, }${repo_nwo_full}" ;;
  esac
}

remember_deleted() {
  local kind=$1 id=$2 key
  if ((open_proj < 0)); then
    return
  fi
  if [[ $kind == artifact ]]; then
    key="a:${id}"
  else
    key="c:${id}"
  fi
  case $SKIP_SET in
    *"|${key}|"*) return ;;
  esac
  printf '%s\n' "$key" >> "$(proj_skip_file "$open_proj")"
  SKIP_SET+="${key}|"
}

# Delete whatever is checked in the current model, largest first.
# Adds to RESULT_* and session counters. Sets DELETED_N to how many
# requests were attempted. Returns 1 when nothing is checked.
delete_current_selection() {
  local base=${1:-0}
  local i idx n=0 total ok err
  work_sel=()
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_dead[$i]} != 1 && ${item_on[$i]} == 1 ]]; then
      work_sel+=("$i")
    fi
  done
  total=${#work_sel[@]}
  DELETED_N=0
  if ((total == 0)); then
    return 1
  fi
  sort_work_by_size
  if ((GRAND_TOTAL <= 0)); then
    GRAND_TOTAL=$total
  fi
  mode=working
  for idx in "${work_sel[@]}"; do
    if ((ABORT)); then
      break
    fi
    n=$((n + 1))
    DELETED_N=$n
    WORK_INDEX=$((base + n))
    WORK_TOTAL=$GRAND_TOTAL
    WORK_LABEL="${repo_nwo_full}  ${item_name[$idx]}"
    WORK_DETAIL="${item_kind[$idx]} #${item_id[$idx]}"
    WORK_FREED=$RESULT_BYTES
    WORK_FAILS=$RESULT_FAILS
    WORK_NOTE=""
    draw || true
    ok=0
    if [[ ${item_kind[$idx]} == artifact ]]; then
      if delete_artifact "${item_id[$idx]}"; then
        ok=1
      fi
    else
      if delete_cache "${item_id[$idx]}"; then
        ok=1
      fi
    fi
    if ((ABORT && ok == 0)); then
      break
    fi
    if ((ok)); then
      remember_deleted "${item_kind[$idx]}" "${item_id[$idx]}"
      item_dead[$idx]=1
      item_on[$idx]=0
      RESULT_BYTES=$((RESULT_BYTES + ${item_size[$idx]}))
      if [[ ${item_kind[$idx]} == artifact ]]; then
        RESULT_ART=$((RESULT_ART + 1))
        session_art=$((session_art + 1))
      else
        RESULT_CACHE=$((RESULT_CACHE + 1))
        session_cache=$((session_cache + 1))
      fi
      session_bytes=$((session_bytes + ${item_size[$idx]}))
      note_session_repo
    else
      RESULT_FAILS=$((RESULT_FAILS + 1))
      err=$(clean_err "$GH_OUT")
      fail_lines+=("$(printf '%s #%s  %s  %s' "${item_kind[$idx]}" "${item_id[$idx]}" "$(fit_print "${item_name[$idx]}" 24)" "$err")")
    fi
  done
  return 0
}

perform_deletes() {
  RESULT_ART=0
  RESULT_CACHE=0
  RESULT_BYTES=0
  RESULT_FAILS=0
  RESULT_ABORT=0
  fail_lines=()
  GRAND_TOTAL=0
  ABORT=0
  trap 'ABORT=1' INT
  if ! delete_current_selection 0; then
    trap 'exit 130' INT
    mode=$return_mode
    status_msg="Nothing selected"
    return
  fi
  trap 'exit 130' INT
  RESULT_ABORT=$ABORT
  RESULT_WHERE=$repo_nwo_full
  build_view
  place_cursor "" ""
  ensure_scroll
  if ((open_proj >= 0)); then
    record_project_stats "$open_proj"
  fi
  mode=result
  draw || true
}

# --- projects ------------------------------------------------------------

PROJ_LIST_CAP=200

proj_art_file() { printf '%s/p%s.art' "$tmpdir" "$1"; }
proj_cache_file() { printf '%s/p%s.cache' "$tmpdir" "$1"; }
proj_skip_file() { printf '%s/p%s.skip' "$tmpdir" "$1"; }

reset_projects() {
  n_proj=0
  proj_owner=()
  proj_name=()
  proj_host=()
  proj_api=()
  proj_nwo=()
  proj_on=()
  proj_scanned=()
  proj_art_n=()
  proj_art_bytes=()
  proj_exp_n=()
  proj_exp_bytes=()
  proj_cache_n=()
  proj_cache_bytes=()
  proj_error=()
  proj_view=()
  proj_cursor=0
  proj_scroll=0
}

add_project() {
  local spec=$1 i
  if ! parse_repo "$spec"; then
    return 1
  fi
  for ((i = 0; i < n_proj; i++)); do
    if [[ ${proj_nwo[$i]} == "$repo_nwo_full" ]]; then
      return 0
    fi
  done
  proj_owner+=("$owner")
  proj_name+=("$name")
  proj_host+=("$host")
  proj_api+=("$api_hostname")
  proj_nwo+=("$repo_nwo_full")
  proj_on+=(0)
  proj_scanned+=(0)
  proj_art_n+=(0)
  proj_art_bytes+=(0)
  proj_exp_n+=(0)
  proj_exp_bytes+=(0)
  proj_cache_n+=(0)
  proj_cache_bytes+=(0)
  proj_error+=("")
  n_proj=$((n_proj + 1))
  : > "$(proj_art_file "$((n_proj - 1))")"
  : > "$(proj_cache_file "$((n_proj - 1))")"
  : > "$(proj_skip_file "$((n_proj - 1))")"
  return 0
}

bind_project() {
  local p=$1
  owner=${proj_owner[$p]}
  name=${proj_name[$p]}
  host=${proj_host[$p]}
  api_hostname=${proj_api[$p]}
  repo_nwo_full=${proj_nwo[$p]}
  repo=$repo_nwo_full
  open_proj=$p
}

load_skip_set() {
  local f line
  SKIP_SET="|"
  f=$(proj_skip_file "$1")
  [[ -f $f ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line ]] && continue
    SKIP_SET+="${line}|"
  done < "$f"
}

record_project_stats() {
  local p=$1 i an=0 ab=0 en=0 eb=0 cn=0 cb=0
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_dead[$i]} == 1 ]]; then
      continue
    fi
    if [[ ${item_kind[$i]} == artifact ]]; then
      an=$((an + 1))
      ab=$((ab + ${item_size[$i]}))
      if [[ ${item_expired[$i]} == 1 ]]; then
        en=$((en + 1))
        eb=$((eb + ${item_size[$i]}))
      fi
    else
      cn=$((cn + 1))
      cb=$((cb + ${item_size[$i]}))
    fi
  done
  proj_art_n[$p]=$an
  proj_art_bytes[$p]=$ab
  proj_exp_n[$p]=$en
  proj_exp_bytes[$p]=$eb
  proj_cache_n[$p]=$cn
  proj_cache_bytes[$p]=$cb
  proj_scanned[$p]=1
  proj_error[$p]=""
}

load_project_model() {
  local p=$1
  bind_project "$p"
  load_skip_set "$p"
  ART_RAW=""
  CACHE_RAW=""
  if [[ -f $(proj_art_file "$p") ]]; then
    ART_RAW=$(cat "$(proj_art_file "$p")")
  fi
  if [[ -f $(proj_cache_file "$p") ]]; then
    CACHE_RAW=$(cat "$(proj_cache_file "$p")")
  fi
  art_error=""
  cache_error=""
  first_build=1
  apply_streams
  open_proj=$p
}

scan_project() {
  local p=$1 a_ok=1 c_ok=1 a_err="" c_err=""
  bind_project "$p"
  : > "$(proj_skip_file "$p")"
  SKIP_SET="|"
  draw_loading "Reading ${proj_nwo[$p]}…"
  if ((want_art)); then
    if fetch_text art; then
      printf '%s\n' "$FETCH_OUT" > "$(proj_art_file "$p")"
    else
      a_ok=0
      a_err=$(read_err)
    fi
  else
    : > "$(proj_art_file "$p")"
  fi
  if ((want_cache)); then
    if fetch_text cache; then
      printf '%s\n' "$FETCH_OUT" > "$(proj_cache_file "$p")"
    else
      c_ok=0
      c_err=$(read_err)
    fi
  else
    : > "$(proj_cache_file "$p")"
  fi
  if ((want_art && a_ok == 0 && want_cache && c_ok == 0)); then
    proj_error[$p]=${a_err:-$c_err}
    proj_scanned[$p]=0
    return 1
  fi
  if ((want_art && ! want_cache && a_ok == 0)); then
    proj_error[$p]=${a_err:-could not list artifacts}
    proj_scanned[$p]=0
    return 1
  fi
  if ((want_cache && ! want_art && c_ok == 0)); then
    proj_error[$p]=${c_err:-could not list caches}
    proj_scanned[$p]=0
    return 1
  fi
  if ((a_ok == 0)); then
    : > "$(proj_art_file "$p")"
  fi
  if ((c_ok == 0)); then
    : > "$(proj_cache_file "$p")"
  fi
  load_project_model "$p"
  record_project_stats "$p"
  if ((a_ok == 0)); then
    proj_error[$p]=${a_err:-could not list artifacts}
  elif ((c_ok == 0)); then
    proj_error[$p]=${c_err:-could not list caches}
  fi
  return 0
}

open_project_items() {
  local p=$1
  if [[ ${proj_scanned[$p]} != 1 ]]; then
    if ! scan_project "$p"; then
      status_msg="Could not read ${proj_nwo[$p]}: ${proj_error[$p]}"
      return 1
    fi
  else
    load_project_model "$p"
  fi
  if [[ -n $initial_filter && -z $filter ]]; then
    filter=$initial_filter
    filter_l=$(printf '%s' "$filter" | tr '[:upper:]' '[:lower:]')
  fi
  build_view
  place_cursor "" ""
  ensure_scroll
  mode=list
  return_mode=list
  filter_edit=0
  return 0
}

back_to_projects() {
  if ((open_proj >= 0 && n_items >= 0)); then
    record_project_stats "$open_proj"
  fi
  mode=projects
  return_mode=projects
  filter_edit=0
  status_msg=""
  rebuild_proj_view
}

load_repo_names() {
  local who=$1 out err line n_before
  err=$(mktemp "${tmpdir}/repolist.XXXXXX")
  n_before=$n_proj
  if [[ -n $who ]]; then
    if ! out=$(gh repo list "$who" --limit "$PROJ_LIST_CAP" --json nameWithOwner --jq '.[].nameWithOwner' </dev/null 2>"$err"); then
      proj_note=$(head -n 1 "$err" 2>/dev/null || true)
      proj_note=${proj_note#gh: }
      [[ -n $proj_note ]] || proj_note="Could not list repositories for ${who}."
      rm -f "$err"
      return 1
    fi
  else
    if ! out=$(gh repo list --limit "$PROJ_LIST_CAP" --json nameWithOwner --jq '.[].nameWithOwner' </dev/null 2>"$err"); then
      proj_note=$(head -n 1 "$err" 2>/dev/null || true)
      proj_note=${proj_note#gh: }
      [[ -n $proj_note ]] || proj_note="Could not list your repositories."
      rm -f "$err"
      return 1
    fi
  fi
  rm -f "$err"
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line ]] && continue
    add_project "$line" || true
  done <<< "$out"
  if ((n_proj - n_before >= PROJ_LIST_CAP)); then
    proj_note="Showing the first ${PROJ_LIST_CAP} repositories."
  fi
  return 0
}

collect_projects() {
  local spec err info nwo url h
  reset_projects
  proj_note=""
  if ((${#cli_repos[@]} > 0)); then
    for spec in "${cli_repos[@]}"; do
      if ! add_project "$spec"; then
        die "not a repository name: ${spec}"
      fi
    done
    return 0
  fi
  if [[ -n $org_name ]]; then
    printf 'Listing %s…\n' "$org_name" >&2
    load_repo_names "$org_name" || true
    return 0
  fi
  if [[ -n $user_name ]]; then
    printf 'Listing %s…\n' "$user_name" >&2
    load_repo_names "$user_name" || true
    return 0
  fi
  if ((list_mine)); then
    printf 'Listing your repositories…\n' >&2
    load_repo_names "" || true
    return 0
  fi
  if [[ -n ${GH_REPO:-} ]]; then
    if ! add_project "$GH_REPO"; then
      die "not a repository name: ${GH_REPO}"
    fi
    return 0
  fi
  err=$(mktemp "${tmpdir}/repo.XXXXXX")
  if info=$(gh repo view --json nameWithOwner,url -q '[.nameWithOwner, .url] | @tsv' </dev/null 2>"$err"); then
    rm -f "$err"
    nwo=${info%%$'\t'*}
    url=${info#*$'\t'}
    repo=$nwo
    if [[ $url =~ ^https?://([^/]+)/ ]]; then
      h=${BASH_REMATCH[1]}
      if [[ $h != github.com && $h != www.github.com && $h != api.github.com ]]; then
        repo="${h}/${nwo}"
      fi
    fi
    add_project "$repo" || true
    return 0
  fi
  rm -f "$err"
  printf 'Listing your repositories…\n' >&2
  load_repo_names "" || true
  return 0
}

rebuild_proj_view() {
  local i needle hay
  proj_view=()
  needle=$(printf '%s' "$proj_filter" | tr '[:upper:]' '[:lower:]')
  for ((i = 0; i < n_proj; i++)); do
    if [[ -z $needle ]]; then
      proj_view+=("$i")
      continue
    fi
    hay=$(printf '%s' "${proj_nwo[$i]}" | tr '[:upper:]' '[:lower:]')
    case $hay in
      *"$needle"*) proj_view+=("$i") ;;
    esac
  done
  if ((${#proj_view[@]} == 0)); then
    proj_cursor=0
    proj_scroll=0
    return
  fi
  if ((proj_cursor >= ${#proj_view[@]})); then
    proj_cursor=$((${#proj_view[@]} - 1))
  fi
  if ((proj_cursor < 0)); then
    proj_cursor=0
  fi
}

proj_window_size() {
  PROJ_WIN=$((ROWS - 1 - 6))
  if ((PROJ_WIN < 1)); then
    PROJ_WIN=1
  fi
}

ensure_proj_scroll() {
  local n max
  term_size
  proj_window_size
  n=${#proj_view[@]}
  if ((n == 0)); then
    proj_scroll=0
    return
  fi
  if ((proj_cursor < 0)); then
    proj_cursor=0
  fi
  if ((proj_cursor >= n)); then
    proj_cursor=$((n - 1))
  fi
  if ((proj_cursor < proj_scroll)); then
    proj_scroll=$proj_cursor
  fi
  if ((proj_cursor >= proj_scroll + PROJ_WIN)); then
    proj_scroll=$((proj_cursor - PROJ_WIN + 1))
  fi
  max=$((n - PROJ_WIN))
  if ((max < 0)); then
    max=0
  fi
  if ((proj_scroll > max)); then
    proj_scroll=$max
  fi
  if ((proj_scroll < 0)); then
    proj_scroll=0
  fi
}

proj_move() {
  local dir=$1 n i
  n=${#proj_view[@]}
  if ((n <= 0)); then
    return
  fi
  i=$((proj_cursor + dir))
  if ((i < 0)); then
    i=$((n - 1))
  elif ((i >= n)); then
    i=0
  fi
  proj_cursor=$i
  ensure_proj_scroll
}

project_right() {
  local p=$1 s
  if [[ ${proj_scanned[$p]} != 1 ]]; then
    if [[ -n ${proj_error[$p]} ]]; then
      printf 'unreadable'
    else
      printf 'not scanned'
    fi
    return
  fi
  s=$(printf '%d %s%s%s' \
    "${proj_art_n[$p]}" \
    "$(plural_word "${proj_art_n[$p]}" artifact artifacts)" \
    "$SEP" \
    "$(human_size "${proj_art_bytes[$p]}")")
  if ((want_cache)); then
    s+=$(printf '%s%d %s%s%s' \
      "$SEP" \
      "${proj_cache_n[$p]}" \
      "$(plural_word "${proj_cache_n[$p]}" cache caches)" \
      "$SEP" \
      "$(human_size "${proj_cache_bytes[$p]}")")
  fi
  if ((proj_exp_n[$p] > 0)); then
    s+=$(printf '%s%s expired' "$SEP" "$(human_size "${proj_exp_bytes[$p]}")")
  fi
  printf '%s' "$s"
}

project_summary() {
  local i p n=0 known=0 bytes=0 unscanned=0
  for ((i = 0; i < n_proj; i++)); do
    if [[ ${proj_on[$i]} != 1 ]]; then
      continue
    fi
    n=$((n + 1))
    if [[ ${proj_scanned[$i]} == 1 ]]; then
      known=$((known + 1))
      bytes=$((bytes + proj_art_bytes[$i] + proj_cache_bytes[$i]))
    else
      unscanned=$((unscanned + 1))
    fi
  done
  if [[ -n $status_msg ]]; then
    printf '%s' "$status_msg"
    return
  fi
  if ((n == 0)); then
    printf 'nothing marked'
    return
  fi
  printf '%d %s marked' "$n" "$(plural_word "$n" project projects)"
  if ((known > 0)); then
    printf '%s%s scanned' "$SEP" "$(human_size "$bytes")"
  fi
  if ((unscanned > 0)); then
    printf '%s%d not scanned' "$SEP" "$unscanned"
  fi
}

compose_projects() {
  local win i row p cur right info plain color
  term_size
  USABLE=$((COLS - 1))
  if ((USABLE < 20)); then
    USABLE=20
  fi
  proj_window_size
  win=$PROJ_WIN
  ensure_proj_scroll
  plain="gh-sweep  projects"
  if ((dry_run)); then
    plain+="   dry-run"
  fi
  _fit "$plain" "$USABLE"
  plain=$FIT
  color=$plain
  if ((use_color)); then
    color="${C_BCYAN}gh-sweep${C_RESET}  ${C_BOLD}projects${C_RESET}"
    if ((dry_run)); then
      color+="   ${C_YELLOW}dry-run${C_RESET}"
    fi
  fi
  add_line "title" "$plain" "$color"
  if [[ -n $proj_filter ]]; then
    info="/ ${proj_filter}"
    if ((proj_filter_edit)); then
      info+="_"
    fi
    info+=$(printf '%s%d shown' "$SEP" "${#proj_view[@]}")
    add_text plain "$info"
  elif [[ -n $proj_note ]]; then
    add_text warn "$proj_note"
  else
    add_text dim "space wipes a whole project    enter picks artifacts and caches"
  fi
  add_line "blank" "" ""
  if ((${#proj_view[@]} == 0)); then
    if [[ -n $proj_filter ]]; then
      add_text plain "No projects match \"${proj_filter}\"."
    else
      add_text plain "No projects yet."
      add_text dim "Press + and type owner/repo, or run gh-sweep --org name."
    fi
    while ((${#screen_lines[@]} < 3 + win)); do
      add_line "blank" "" ""
    done
  else
    for ((i = 0; i < win; i++)); do
      row=$((proj_scroll + i))
      if ((row >= ${#proj_view[@]})); then
        add_line "blank" "" ""
        continue
      fi
      p=${proj_view[$row]}
      cur=0
      if ((row == proj_cursor)); then
        cur=1
      fi
      right=$(project_right "$p")
      if [[ ${proj_on[$p]} == 1 ]]; then
        make_line 0 "$cur" all "${proj_nwo[$p]}" "$right" section
      else
        make_line 0 "$cur" none "${proj_nwo[$p]}" "$right" section
      fi
    done
  fi
  while ((${#screen_lines[@]} < 3 + win)); do
    add_line "blank" "" ""
  done
  while ((${#screen_lines[@]} > 3 + win)); do
    trim_last_line
  done
  add_rule
  plain=$(project_summary)
  _fit "$plain" "$USABLE"
  plain=$FIT
  color=$plain
  if ((use_color)); then
    if [[ -n $status_msg ]]; then
      color="${C_YELLOW}${plain}${C_RESET}"
    else
      color="${C_DIM}${plain}${C_RESET}"
    fi
  fi
  add_line "summary" "$plain" "$color"
  if ((proj_filter_edit)); then
    info="type to filter    enter done    esc clear"
  elif [[ -n $proj_filter ]]; then
    info="esc clears filter    space mark    enter open    d wipe    q quit"
  else
    info="space mark    enter pick    a all    n none    d wipe    s scan    + add    / find    q quit"
  fi
  _fit "$info" "$USABLE"
  info=$FIT
  color=$info
  if ((use_color)); then
    color="${C_DIM}${info}${C_RESET}"
  fi
  add_line "keys" "$info" "$color"
}

toggle_project_at_cursor() {
  local p
  if ((${#proj_view[@]} == 0)); then
    return
  fi
  p=${proj_view[$proj_cursor]}
  if [[ ${proj_on[$p]} == 1 ]]; then
    proj_on[$p]=0
  else
    proj_on[$p]=1
  fi
}

set_visible_projects() {
  local v=$1 row p
  if ((${#proj_view[@]} == 0)); then
    return
  fi
  for row in "${proj_view[@]}"; do
    proj_on[$row]=$v
  done
}

scan_cursor_or_marked() {
  local i p any=0 failed=0
  for ((i = 0; i < n_proj; i++)); do
    if [[ ${proj_on[$i]} == 1 ]]; then
      any=1
      if ! scan_project "$i"; then
        failed=$((failed + 1))
      fi
    fi
  done
  if ((any == 0 && ${#proj_view[@]} > 0)); then
    p=${proj_view[$proj_cursor]}
    if ! scan_project "$p"; then
      status_msg="Could not read ${proj_nwo[$p]}: ${proj_error[$p]}"
      return
    fi
    status_msg="Scanned ${proj_nwo[$p]}"
    return
  fi
  if ((any == 0)); then
    status_msg="Nothing to scan"
    return
  fi
  if ((failed > 0)); then
    status_msg="Scanned with ${failed} $(plural_word "$failed" failure failures)"
  else
    status_msg="Scanned"
  fi
}

begin_project_wipe() {
  local i n=0 items=0 bytes=0 exp_bytes=0 failed=""
  for ((i = 0; i < n_proj; i++)); do
    if [[ ${proj_on[$i]} != 1 ]]; then
      continue
    fi
    n=$((n + 1))
    if [[ ${proj_scanned[$i]} != 1 ]]; then
      if ! scan_project "$i"; then
        failed=${proj_nwo[$i]}
        break
      fi
    fi
    items=$((items + proj_art_n[$i] + proj_cache_n[$i]))
    bytes=$((bytes + proj_art_bytes[$i] + proj_cache_bytes[$i]))
    exp_bytes=$((exp_bytes + proj_exp_bytes[$i]))
  done
  if [[ -n $failed ]]; then
    status_msg="Could not read ${failed}"
    mode=projects
    return
  fi
  if ((n == 0)); then
    status_msg="Nothing marked"
    return
  fi
  if ((items == 0)); then
    status_msg="Those projects have no artifacts or caches"
    return
  fi
  confirm_scope=projects
  return_mode=projects
  confirm_buf=""
  status_msg=""
  WIPE_COUNT=$n
  WIPE_ITEMS=$items
  WIPE_BYTES=$bytes
  WIPE_EXPIRED=$exp_bytes
  if ((n > 1)); then
    confirm_strict=1
    confirm_token="wipe"
  elif ((items > STRICT_COUNT || bytes >= STRICT_BYTES)); then
    confirm_strict=1
    confirm_token=""
    for ((i = 0; i < n_proj; i++)); do
      if [[ ${proj_on[$i]} == 1 ]]; then
        confirm_token=${proj_name[$i]}
        repo_nwo_full=${proj_nwo[$i]}
        break
      fi
    done
  else
    confirm_strict=0
    confirm_token=""
  fi
  mode=confirm
}

compose_confirm_projects() {
  local i shown=0 line
  if ((confirm_strict)) && [[ $confirm_token == wipe ]]; then
    add_text error "Wipe ${WIPE_COUNT} projects"
  else
    add_text error "Wipe ${repo_nwo_full}"
  fi
  add_line "blank" "" ""
  if ((dry_run)); then
    add_text warn "Dry run: nothing will be deleted."
  else
    add_text plain "This permanently deletes every artifact and cache in the marked projects."
  fi
  if ((WIPE_EXPIRED > 0)); then
    add_text warn "$(human_size "$WIPE_EXPIRED") of that is expired artifacts. They still use quota."
  fi
  add_line "blank" "" ""
  local max_show=$((ROWS - 16))
  if ((max_show < 3)); then
    max_show=3
  fi
  for ((i = 0; i < n_proj; i++)); do
    if [[ ${proj_on[$i]} != 1 ]]; then
      continue
    fi
    if ((shown >= max_show)); then
      add_text dim "  ... more projects"
      break
    fi
    printf -v line '  %s    %d artifacts    %d caches    %s' \
      "${proj_nwo[$i]}" "${proj_art_n[$i]}" "${proj_cache_n[$i]}" \
      "$(human_size "$((proj_art_bytes[$i] + proj_cache_bytes[$i]))")"
    add_text plain "$line"
    shown=$((shown + 1))
  done
  add_line "blank" "" ""
  printf -v line 'Total  %d   %s' "$WIPE_ITEMS" "$(human_size "$WIPE_BYTES")"
  add_text plain "$line"
  if ((WIPE_ITEMS > 200)); then
    add_text dim "Largest files go first. GitHub allows about 5,000 API calls an hour."
  else
    add_text dim "Largest files are deleted first."
  fi
  add_line "blank" "" ""
  if ((confirm_strict)); then
    add_text plain "Type ${confirm_token} to confirm"
    add_text plain "> ${confirm_buf}_"
    add_text dim "enter confirms    esc cancels"
  else
    if ((dry_run)); then
      add_text plain "y   finish the dry run"
    else
      add_text error "y   delete everything marked"
    fi
    add_text dim "n   go back"
  fi
  if [[ -n $status_msg ]]; then
    add_line "blank" "" ""
    add_text warn "$status_msg"
  fi
}

select_all_live() {
  local i
  for ((i = 0; i < n_items; i++)); do
    if [[ ${item_dead[$i]} != 1 ]]; then
      item_on[$i]=1
    fi
  done
}

perform_project_wipes() {
  local i bytes p
  local order
  order=()
  RESULT_ART=0
  RESULT_CACHE=0
  RESULT_BYTES=0
  RESULT_FAILS=0
  RESULT_ABORT=0
  fail_lines=()
  GRAND_TOTAL=0
  ABORT=0
  : > "$tmpdir/pwipe"
  for ((i = 0; i < n_proj; i++)); do
    if [[ ${proj_on[$i]} != 1 ]]; then
      continue
    fi
    bytes=$((proj_art_bytes[$i] + proj_cache_bytes[$i]))
    GRAND_TOTAL=$((GRAND_TOTAL + proj_art_n[$i] + proj_cache_n[$i]))
    printf '%s\t%s\n' "$bytes" "$i" >> "$tmpdir/pwipe"
  done
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line ]] && continue
    p=${line#*$'\t'}
    [[ -n $p ]] || continue
    order+=("$p")
  done < <(LC_ALL=C sort -t $'\t' -k1,1nr "$tmpdir/pwipe")
  trap 'ABORT=1' INT
  local done=0
  if ((${#order[@]} > 0)); then
    for p in "${order[@]}"; do
      if ((ABORT)); then
        break
      fi
      filter=""
      filter_l=""
      load_project_model "$p"
      select_all_live
      delete_current_selection "$done" || true
      done=$((done + DELETED_N))
      record_project_stats "$p"
      if ((proj_art_n[$p] + proj_cache_n[$p] == 0)); then
        proj_on[$p]=0
      fi
    done
  fi
  trap 'exit 130' INT
  RESULT_ABORT=$ABORT
  if ((WIPE_COUNT == 1)); then
    RESULT_WHERE=$repo_nwo_full
  else
    RESULT_WHERE="${WIPE_COUNT} projects"
  fi
  return_mode=projects
  mode=result
  draw || true
}

select_except_newest() {
  local keep=$1 g i start end rank selected=0 i2
  for ((i2 = 0; i2 < n_items; i2++)); do
    if [[ ${item_kind[$i2]} == artifact ]]; then
      item_on[$i2]=0
    fi
  done
  if ((${#art_groups[@]} == 0)); then
    status_msg="No artifacts"
    return
  fi
  for g in "${art_groups[@]}"; do
    rank=0
    start=${group_start[$g]}
    end=$((start + group_len[$g]))
    for ((i = start; i < end; i++)); do
      if [[ ${item_dead[$i]} == 1 ]]; then
        continue
      fi
      if ! item_match "$i"; then
        continue
      fi
      if ((rank >= keep)); then
        item_on[$i]=1
        selected=$((selected + 1))
      fi
      rank=$((rank + 1))
    done
  done
  status_msg="Selected ${selected} $(plural_word "$selected" artifact artifacts), keeping the newest ${keep} of each name"
}

apply_proj_filter() {
  rebuild_proj_view
  ensure_proj_scroll
}

handle_proj_filter_key() {
  local key=$1
  status_msg=""
  case $key in
    $'\r'|$'\n') proj_filter_edit=0 ;;
    $'\e')
      proj_filter=""
      proj_filter_edit=0
      apply_proj_filter
      ;;
    $'\x7f'|$'\b')
      proj_filter=${proj_filter%?}
      apply_proj_filter
      ;;
    $'\x15')
      proj_filter=""
      apply_proj_filter
      ;;
    $'\e[A'|$'\eOA') proj_move -1 ;;
    $'\e[B'|$'\eOB') proj_move 1 ;;
    *)
      if is_printable "$key"; then
        proj_filter+="$key"
        apply_proj_filter
      fi
      ;;
  esac
}

handle_project_key() {
  local key=$1 p step
  status_msg=""
  case $key in
    $'\e[A'|$'\eOA'|k) proj_move -1 ;;
    $'\e[B'|$'\eOB'|j) proj_move 1 ;;
    $'\e[5~'|K)
      step=0
      while ((step < 5 && proj_cursor > 0)); do
        proj_cursor=$((proj_cursor - 1))
        step=$((step + 1))
      done
      ensure_proj_scroll
      ;;
    $'\e[6~'|J)
      step=0
      while ((step < 5 && proj_cursor + 1 < ${#proj_view[@]})); do
        proj_cursor=$((proj_cursor + 1))
        step=$((step + 1))
      done
      ensure_proj_scroll
      ;;
    g|$'\e[H')
      proj_cursor=0
      ensure_proj_scroll
      ;;
    G|$'\e[F')
      if ((${#proj_view[@]} > 0)); then
        proj_cursor=$((${#proj_view[@]} - 1))
      fi
      ensure_proj_scroll
      ;;
    ' ') toggle_project_at_cursor ;;
    $'\r'|$'\n'|$'\e[C'|$'\eOC'|l)
      if ((${#proj_view[@]} > 0)); then
        p=${proj_view[$proj_cursor]}
        open_project_items "$p" || true
      fi
      ;;
    a) set_visible_projects 1 ;;
    n|N) set_visible_projects 0 ;;
    d) begin_project_wipe ;;
    s) scan_cursor_or_marked ;;
    +|=) begin_add_prompt ;;
    /) proj_filter_edit=1 ;;
    '?'|$'\eOP')
      help_from=projects
      mode=help
      ;;
    q|Q) QUIT=1 ;;
    $'\e')
      if [[ -n $proj_filter ]]; then
        proj_filter=""
        proj_filter_edit=0
        apply_proj_filter
      fi
      ;;
  esac
}

# --- terminal lifecycle --------------------------------------------------

setup_terminal() {
  saved_stty=$(stty -g)
  if tput smcup 2>/dev/null; then
    ALT_MODE="tput"
  else
    printf '\033[?1049h'
    ALT_MODE=ansi
  fi
  if ! tput civis 2>/dev/null; then
    printf '\033[?25l'
  fi
  printf '\033[?7l\033[?2004h'
  stty -echo -icanon min 1 time 0
  in_alt=1
  printf '\033]0;gh-sweep %s\007' "$repo_nwo_full"
}

on_stop() {
  set +e
  printf '\033[?2004l\033[?7h'
  if [[ ${ALT_MODE:-} == tput ]]; then
    tput cnorm 2>/dev/null
    tput rmcup 2>/dev/null
  else
    printf '\033[?25h\033[?1049l'
  fi
  if [[ -n ${saved_stty:-} ]]; then
    stty "$saved_stty" 2>/dev/null || stty sane 2>/dev/null
  fi
  in_alt=0
  trap - TSTP
  kill -TSTP $$
}

on_cont() {
  trap on_stop TSTP
  setup_terminal || true
  draw || true
}

print_session_summary() {
  local total verb
  total=$((${session_art:-0} + ${session_cache:-0}))
  if ((total == 0)); then
    return
  fi
  if ((${dry_run:-0})); then
    verb="would delete"
  else
    verb="deleted"
  fi
  printf 'gh-sweep: %s %d %s and %d %s from %s (%s)\n' \
    "$verb" \
    "${session_art:-0}" "$(plural_word "${session_art:-0}" artifact artifacts)" \
    "${session_cache:-0}" "$(plural_word "${session_cache:-0}" cache caches)" \
    "${session_repo_list:-${repo_nwo_full:-${repo:-}}}" \
    "$(human_size "${session_bytes:-0}")"
}

cleanup() {
  set +e
  if [[ ${cleaned:-0} == 1 ]]; then
    return
  fi
  cleaned=1
  printf '\033[?2004l\033[?7h' 2>/dev/null
  if ((${in_alt:-0})); then
    if [[ ${ALT_MODE:-} == tput ]]; then
      tput cnorm 2>/dev/null
      tput rmcup 2>/dev/null
    else
      printf '\033[?25h\033[?1049l'
    fi
    in_alt=0
  fi
  if [[ -n ${saved_stty:-} ]]; then
    stty "$saved_stty" 2>/dev/null || stty sane 2>/dev/null
  fi
  if [[ -n ${tmpdir:-} && -d ${tmpdir:-} ]]; then
    rm -rf "$tmpdir"
  fi
  tmpdir=""
  print_session_summary
}

require_gh() {
  if ! command -v gh >/dev/null 2>&1; then
    printf 'gh-sweep: the GitHub CLI (gh) is not installed.\n' >&2
    printf 'Install it from https://cli.github.com and run: gh auth login\n' >&2
    exit 1
  fi
}

resolve_repo() {
  local err info nwo url h
  if [[ -z $repo && -n ${GH_REPO:-} ]]; then
    repo=$GH_REPO
  fi
  if [[ -z $repo ]]; then
    err=$(mktemp "${tmpdir}/repo.XXXXXX")
    if ! info=$(gh repo view --json nameWithOwner,url -q '[.nameWithOwner, .url] | @tsv' 2>"$err"); then
      printf 'gh-sweep: could not detect a repository.\n' >&2
      printf 'Pass owner/repo, or run gh-sweep inside a checkout.\n' >&2
      if [[ -s $err ]]; then
        head -n 1 "$err" >&2
      fi
      rm -f "$err"
      exit 1
    fi
    rm -f "$err"
    nwo=${info%%$'\t'*}
    url=${info#*$'\t'}
    repo=$nwo
    if [[ $url =~ ^https?://([^/]+)/ ]]; then
      h=${BASH_REMATCH[1]}
      if [[ $h != github.com && $h != www.github.com && $h != api.github.com ]]; then
        repo="${h}/${nwo}"
      fi
    fi
  fi
  if ! parse_repo "$repo"; then
    die "not a repository name: ${repo}"
  fi
}

require_auth() {
  local err ok=0
  err=$(mktemp "${tmpdir}/auth.XXXXXX")
  if [[ -n $api_hostname ]]; then
    if gh auth status --hostname "$api_hostname" </dev/null >"$err" 2>&1; then
      ok=1
    fi
  else
    if gh auth status </dev/null >"$err" 2>&1; then
      ok=1
    fi
  fi
  rm -f "$err"
  if ((ok == 0)); then
    printf 'gh-sweep: gh is not logged in.\n' >&2
    if [[ -n $api_hostname ]]; then
      printf 'Run: gh auth login --hostname %s\n' "$api_hostname" >&2
    else
      printf 'Run: gh auth login\n' >&2
    fi
    exit 1
  fi
}

ui_loop() {
  while (( ! QUIT )); do
    draw
    if ! read_key; then
      if ((WINCH)); then
        WINCH=0
        continue
      fi
      break
    fi
    if ((WINCH)); then
      WINCH=0
    fi
    handle_key
  done
}

main() {
  set -euo pipefail
  if ((BASH_VERSINFO[0] < 3)) || { ((BASH_VERSINFO[0] == 3)) && ((BASH_VERSINFO[1] < 2)); }; then
    printf 'gh-sweep: needs bash 3.2 or newer (this is %s).\n' "$BASH_VERSION" >&2
    exit 1
  fi
  parse_args "$@"
  init_runtime
  require_gh
  require_auth
  export GH_PROMPT_DISABLED=1
  export GH_NO_UPDATE_NOTIFIER=1
  export GH_PAGER=cat
  export PAGER=cat
  export GIT_TERMINAL_PROMPT=0
  collect_projects
  if [[ ! -t 0 || ! -t 1 ]]; then
    printf 'gh-sweep: this UI needs a terminal.\n' >&2
    exit 1
  fi
  trap cleanup EXIT
  trap 'exit 130' INT TERM
  trap 'WINCH=1' WINCH
  trap on_stop TSTP
  trap on_cont CONT
  setup_terminal
  if [[ -n $initial_filter ]]; then
    filter=$initial_filter
    filter_l=$(printf '%s' "$filter" | tr '[:upper:]' '[:lower:]')
  fi
  rebuild_proj_view
  mode=projects
  ui_loop
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
