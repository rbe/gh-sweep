#!/usr/bin/env bash
# Stand-in for gh. Prints the post-jq inventory the script expects.
log=${GH_MOCK_LOG:?}
{
  printf 'CALL'
  for a in "$@"; do
    printf '\t%s' "$a"
  done
  printf '\n'
} >> "$log"

if [[ ${1:-} == auth ]]; then
  exit 0
fi

if [[ ${1:-} == repo && ${2:-} == list ]]; then
  printf '%s\n' "${GH_MOCK_REPOS:-acme/widgets}"
  exit 0
fi

method="GET"
endpoint=""
repo=""
prev=""
for a in "$@"; do
  if [[ $a == DELETE || $a == PUT ]]; then
    method=$a
  fi
  if [[ $a == repos/* ]]; then
    endpoint=$a
  fi
  if [[ $prev == -R || $prev == --repo ]]; then
    repo=$a
  fi
  prev=$a
done

nwo_from_endpoint() {
  local body=${1#repos/}
  printf '%s' "${body%%/actions/*}"
}

# The settings endpoints. GH_MOCK_SETTINGS_FAIL names a repository whose
# settings calls fail.
if [[ ${1:-} == api && $endpoint == */actions/permissions/* ]]; then
  nwo=$(nwo_from_endpoint "$endpoint")
  if [[ $nwo == "${GH_MOCK_SETTINGS_FAIL:-}" ]]; then
    printf 'HTTP 404: Not Found\n' >&2
    exit 1
  fi
  fields=""
  for a in "$@"; do
    if [[ $a == days=* || $a == default_workflow_permissions=* || $a == can_approve_pull_request_reviews=* ]]; then
      fields="$fields $a"
    fi
  done
  case "$method ${endpoint##*/}" in
    "GET artifact-and-log-retention") printf '%s\n' "${GH_MOCK_RETENTION:-90 90}" ;;
    "GET workflow") printf '%s\n' "${GH_MOCK_WORKFLOW:-read false}" ;;
    "PUT artifact-and-log-retention") printf 'PUT_RETENTION %s%s\n' "$nwo" "$fields" >> "$log" ;;
    "PUT workflow") printf 'PUT_WORKFLOW %s%s\n' "$nwo" "$fields" >> "$log" ;;
    *)
      printf 'unexpected gh invocation: %s\n' "$*" >&2
      exit 1
      ;;
  esac
  exit 0
fi

# GH_MOCK_FAIL names a repository whose artifacts fail.
# GH_MOCK_CACHE_FAIL names a repository whose caches fail.
if [[ ${1:-} == api && $endpoint == *actions/artifacts* && $method == GET ]]; then
  if [[ $(nwo_from_endpoint "$endpoint") == "${GH_MOCK_FAIL:-}" ]]; then
    printf 'HTTP 404: Not Found\n' >&2
    exit 1
  fi
fi
if [[ ${1:-} == cache && $repo == "${GH_MOCK_CACHE_FAIL:-}" && -n $repo ]]; then
  printf 'HTTP 403: Resource not accessible by personal access token\n' >&2
  exit 1
fi

if [[ ${1:-} == api ]]; then
  if [[ $method == DELETE ]]; then
    id=${endpoint##*/}
    nwo=$(nwo_from_endpoint "$endpoint")
    printf 'DELETE_ARTIFACT %s %s\n' "$nwo" "$id" >> "$log"
    exit 0
  fi
  if [[ $endpoint == *actions/artifacts* ]]; then
    nwo=$(nwo_from_endpoint "$endpoint")
    printf 'LIST_ARTIFACTS %s\n' "$nwo" >> "$log"
    if [[ $nwo == other/lib ]]; then
      cat "$GH_MOCK_ART_OTHER"
    else
      cat "$GH_MOCK_ART"
    fi
    exit 0
  fi
fi

if [[ ${1:-} == cache ]]; then
  if [[ ${2:-} == list || ${2:-} == ls ]]; then
    printf 'LIST_CACHES %s\n' "$repo" >> "$log"
    if [[ $repo == other/lib ]]; then
      : > /dev/null
    else
      cat "$GH_MOCK_CACHES"
    fi
    exit 0
  fi
  if [[ ${2:-} == delete ]]; then
    id=""
    for a in "$@"; do
      if [[ $a =~ ^[0-9]+$ ]]; then
        id=$a
      fi
    done
    printf 'DELETE_CACHE %s %s\n' "$repo" "$id" >> "$log"
    exit 0
  fi
fi

printf 'unexpected gh invocation: %s\n' "$*" >&2
exit 1
